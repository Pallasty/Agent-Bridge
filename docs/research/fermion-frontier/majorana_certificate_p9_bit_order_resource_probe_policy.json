  "D0_to_S0_lifecycle": [
    {
      "stage": "D0_PRECOMMIT",
      "requirements": "commit this policy fixture candidate fixed admission observation contract stop rules source pins and driver before any P9 execution"
    },
    {
      "stage": "D0_SINGLE_FORMAL_RESOURCE_PROBE",
      "requirements": "run the sole candidate once from O0 under fixed admission and expose only the allowed aggregate resource witness"
    },
    {
      "stage": "D0_PREFIX_RESOURCE_CONFORMANCE",
      "requirements": "compare every frozen P6 aggregate resource field and start step3 only after complete conformance"
    },
    {
      "stage": "D0_REPORT",
      "requirements": "materialize a canonical scientific-authority-NONE report with fixed formal admission copied from policy rather than derived from observations"
    },
    {
      "stage": "S0_RESULT_UNPINNED_PRECOMMIT",
      "requirements": "in a direct child of a successful D0 report freeze formal source custody fixed admission two fresh replays independent checker and result artifact absence"
    },
    {
      "stage": "S0_RAW_REPLAYS",
      "requirements": "run two fresh isolated processes from O0 through all three steps and require byte-identical raw stdout"
    },
    {
      "stage": "S0_PREFIX_CONFORMANCE_AND_RECONSTRUCTION",
      "requirements": "after the raw pair completes independently reconstruct step3 and compare the complete P6 prefix field for field before decoding P6 E12"
    },
    {
      "stage": "S0_COMPOSITION",
      "requirements": "inherit conformed P6 E12 once add step3 local once and reconstruct strict local and three-step cumulative comparisons in the outer checker"
    },
    {
      "stage": "S0_RESULT_MATERIALIZATION",
      "requirements": "materialize a bounded three-step result only after all replay and reconstruction obligations and retain all authority exclusions"
    }
  ],
