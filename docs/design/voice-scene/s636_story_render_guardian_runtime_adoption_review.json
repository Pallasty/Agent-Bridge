  "blockers": [
    {
      "id": "B1_REAL_WORKER_ENTRYPOINT",
      "severity": "high",
      "evidence": "S620-selected one-shot Worker file is absent; the executor is only an in-process callable",
      "resolution": "implement a strict one-request one-response adapter with injected synthetic seams and redacted failures",
      "closed": false
    },
    {
      "id": "B2_GUARDIAN_PRODUCT_ENTRYPOINT",
      "severity": "high",
      "evidence": "run_guardian_entrypoint has no product caller and no dedicated Guardian binary is packaged",
      "resolution": "add a minimal dedicated entrypoint that dispatches Guardian and bootstrap roles before normal product initialization",
      "closed": false
    },
    {
      "id": "B3_EXECUTABLE_IDENTITY_TOCTOU",
      "severity": "critical",
      "evidence": "the sealed plan authenticates paths and arguments but not executable or script bytes, identity, mode, owner, or parent custody",
      "resolution": "bind an immutable artifact manifest and descriptor-stable identity checks before any authority-bearing launch",
      "closed": false
    },
    {
      "id": "B4_IMMUTABLE_PACKAGE_AND_PYTHON",
      "severity": "critical",
      "evidence": "deployment omits Worker support files and the synthetic Python lacks all required TTS modules",
      "resolution": "package hash-bound scripts and a fixed offline Python environment under owner-controlled POSIX custody",
      "closed": false
    },
    {
      "id": "B5_SECURE_OUTPUT_ROOT",
      "severity": "high",
      "evidence": "S604 binds a legacy fuseblk output root while S620 requires a private ext4 output root that does not yet exist",
      "resolution": "define and install a 0700 secure output root and regenerate the execution contract against it",
      "closed": false
    },
    {
      "id": "B6_OWNER_AUTHORIZATION_BROKER",
      "severity": "high",
      "evidence": "one prior owner-signed render exists but no runtime broker can deliver a single bounded envelope without exposing the installed key to MCP",
      "resolution": "implement a separate explicit owner-confirmation ingress with single-use short-lived envelopes",
      "closed": false
    },
    {
      "id": "B7_RENDER_MCP_SURFACE",
      "severity": "high",
      "evidence": "only read-only story_command_preflight is registered and visible to the current client",
      "resolution": "add a default-off render adapter only after Worker, identity, output, and authority gates pass",
      "closed": false
    },
    {
      "id": "B8_DEPLOYED_BINARY_AND_INSTALL_TRUST",
      "severity": "critical",
      "evidence": "the installed binary is 14 commits behind, lacks S635, and resides in an observed 0777 root-owned fuseblk location behind a credential-injecting wrapper",
      "resolution": "install Guardian and Worker artifacts into owner-controlled POSIX custody, then separately review deployment and current-client adoption",
      "closed": false
    }
  ],
