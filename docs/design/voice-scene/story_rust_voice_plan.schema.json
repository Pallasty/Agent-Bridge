{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/story_rust_voice_plan.v1.json",
  "title": "Agent-Bridge Rust story voice-plan parity receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "evidence", "vectors", "parity", "scope", "runtime_effects", "next_gate"],
  "properties": {
    "schema": {"const": "agent_bridge.story_rust_voice_plan.v1"},
    "status": {"const": "rust_story_voice_plan_parity_verified"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust_module_path", "rust_module_sha256", "rust_test_path", "rust_test_sha256", "python_voice_plan_path", "python_voice_plan_sha256", "python_cache_key_path", "python_cache_key_sha256"],
      "properties": {
        "rust_module_path": {"type": "string", "minLength": 1},
        "rust_module_sha256": {"$ref": "#/$defs/sha256"},
        "rust_test_path": {"type": "string", "minLength": 1},
        "rust_test_sha256": {"$ref": "#/$defs/sha256"},
        "python_voice_plan_path": {"type": "string", "minLength": 1},
        "python_voice_plan_sha256": {"$ref": "#/$defs/sha256"},
        "python_cache_key_path": {"type": "string", "minLength": 1},
        "python_cache_key_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_count", "plan_sha256", "first_segment_cache_key"],
      "properties": {
        "segment_count": {"const": 5},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "first_segment_cache_key": {"$ref": "#/$defs/sha256"}
      }
    },
    "parity": {"type": "object", "minProperties": 6, "additionalProperties": {"const": true}},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_exported", "mcp_registered", "model_executed", "full_preflight_implemented"],
      "properties": {
        "module_exported": {"const": false},
        "mcp_registered": {"const": false},
        "model_executed": {"const": false},
        "full_preflight_implemented": {"const": false}
      }
    },
    "runtime_effects": {"type": "object", "minProperties": 1, "additionalProperties": {"const": false}},
    "next_gate": {"const": "rust_story_preflight_adapter_parity"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
