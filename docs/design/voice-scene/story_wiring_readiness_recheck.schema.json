{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_bridge.story_wiring_readiness_recheck.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "decision", "freshness", "evidence", "cleanliness", "blockers", "execution_authorized", "runtime_effects", "next_gate"],
  "properties": {
    "schema": {"const": "agent_bridge.story_wiring_readiness_recheck.v1"},
    "status": {"const": "story_wiring_readiness_recheck_complete"},
    "decision": {"const": {"selected": "keep_wiring_deferred_shared_surfaces_not_clean", "wiring_implementation_admitted": false}},
    "freshness": {"const": {"lib_hash_unchanged": true, "registry_hash_unchanged": true, "cargo_hash_unchanged": true, "all_shared_surface_hashes_unchanged": true}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_receipt_sha256", "current_lib_sha256", "current_registry_sha256", "current_cargo_sha256", "active_agent_bridge_cargo_processes"],
      "properties": {
        "prior_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "current_lib_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "current_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "current_cargo_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "active_agent_bridge_cargo_processes": {"const": 2}
      }
    },
    "cleanliness": {"const": {"lib_worktree_clean": false, "registry_worktree_clean": false, "cargo_worktree_clean": false}},
    "blockers": {"const": ["lib_module_tree_not_clean", "registry_not_clean", "cargo_manifest_not_clean", "agent_bridge_cargo_activity_active"]},
    "execution_authorized": {"const": false},
    "runtime_effects": {"type": "object", "minProperties": 10, "additionalProperties": {"const": false}},
    "next_gate": {"const": "shared_surface_cleanliness_recheck"}
  }
}
