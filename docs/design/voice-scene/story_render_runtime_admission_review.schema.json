          "additionalProperties": false
        },
        "installed_binary": {
          "type": "object",
          "required": ["path", "sha256", "version", "source_commit", "commits_behind_source", "current_source"],
          "properties": {
            "path": {"const": "/home/pallasting/.local/bin/agent-bridge.real"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "version": {"type": "string", "minLength": 1},
            "source_commit": {"$ref": "#/$defs/git_sha"},
            "commits_behind_source": {"type": "integer", "minimum": 1},
