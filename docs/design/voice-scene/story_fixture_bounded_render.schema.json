{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_bridge.story_fixture_bounded_render.v1",
  "type": "object",
  "required": ["schema", "status", "authorization", "preflight", "model", "segments", "assembly", "playback", "owner_feedback", "post_processing", "runtime_effects", "claims", "next_gate"],
  "properties": {
    "schema": {"const": "agent_bridge.story_fixture_bounded_render.v1"},
    "status": {"const": "story_fixture_bounded_render_owner_accepted"},
    "authorization": {"const": {"render": true, "play_once": true, "record": false, "write_memory": false}},
    "preflight": {"const": {"receipt": "docs/design/voice-scene/s602_story_fixture_mcp_preflight_receipt.json", "preflight_sha256": "6553dcec1ad51e1b6352d0fc7fa2068b38713d1e37dedacbe45b00f3aca4a1bb", "source_sha256": "a485b7f3151f62c5ed0e118a03f66ee3dc3ddb57eb23b5e7ea93e0abb14f6566", "chapter": 2, "selected_segments": 3}},
    "model": {"const": {"name": "Qwen3-TTS-12Hz-1.7B-CustomVoice", "variant": "community_cpu_int4_onnx", "inference_sha256": "70d3911f6923000d776cd16d575bf6518f6a638ee0adf8c1b60d0e1d34fdeb75", "provider_policy": "cpu_only_gpu_hidden", "offline": true}},
    "segments": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["index", "text", "speaker", "style_instruction", "cache_key", "generated_codec_frames", "frame_cap", "natural_eos", "audio_path", "audio_sha256", "duration_seconds", "sample_rate_hz", "channels"],
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 2},
          "text": {"type": "string", "minLength": 1},
          "speaker": {"enum": ["Vivian", "Serena"]},
          "style_instruction": {"type": "string", "minLength": 1},
          "cache_key": {"pattern": "^[0-9a-f]{64}$"},
          "generated_codec_frames": {"type": "integer", "minimum": 1, "maximum": 99},
          "frame_cap": {"const": 100},
          "natural_eos": {"const": true},
          "audio_path": {"type": "string", "minLength": 1},
          "audio_sha256": {"pattern": "^[0-9a-f]{64}$"},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "sample_rate_hz": {"const": 24000},
          "channels": {"const": 1}
        },
        "additionalProperties": false
      }
    },
    "assembly": {
      "type": "object",
      "required": ["audio_path", "audio_sha256", "codec", "sample_rate_hz", "channels", "sample_width_bytes", "frames", "duration_seconds", "gap_seconds", "mean_volume_db", "max_volume_db", "non_silent"],
      "properties": {
        "audio_path": {"type": "string", "minLength": 1},
        "audio_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "codec": {"const": "pcm_s16le"},
        "sample_rate_hz": {"const": 24000},
        "channels": {"const": 1},
        "sample_width_bytes": {"const": 2},
        "frames": {"const": 165120},
        "duration_seconds": {"const": 6.88},
        "gap_seconds": {"const": [1.0, 1.0]},
        "mean_volume_db": {"type": "number"},
        "max_volume_db": {"type": "number", "maximum": 0},
        "non_silent": {"const": true}
      },
      "additionalProperties": false
    },
    "playback": {"const": {"backend": "pw-play", "authorized": true, "attempts": 1, "exit_code": 0}},
    "owner_feedback": {
      "type": "object",
      "required": ["accepted", "natural", "clear", "speaker_distinction", "intervals", "verbatim_zh"],
      "properties": {
        "accepted": {"const": true}, "natural": {"const": true}, "clear": {"const": true},
        "speaker_distinction": {"const": true}, "intervals": {"const": "accepted"},
        "verbatim_zh": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "post_processing": {"const": {"applied": false, "deferred_candidate": "modest_gain_near_1khz_for_presence", "stage": "later_aesthetic_tuning", "required_for_acceptance": false}},
    "runtime_effects": {"const": {"loaded_model": true, "executed_onnx": true, "rendered_audio": true, "played_audio": true, "recorded_audio": false, "wrote_cache": false, "wrote_memory": false}},
    "claims": {"const": {"bounded_fixture_scope_enforced": true, "all_segments_natural_eos": true, "machine_audio_gate_passed": true, "owner_audibility_verified": true, "owner_acceptance_verified": true, "story_command_preflight_remains_non_actuating": true, "story_command_render_executor_enabled": false, "production_story_render_admitted": false}},
    "next_gate": {"const": "story_bounded_render_execution_contract"}
  },
  "additionalProperties": false
}
