{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_bridge.story_bounded_render_receipt.v1",
  "type": "object",
  "required": ["schema", "status", "authorization_id", "contract_sha256", "preflight_sha256", "segments", "assembly", "runtime_effects", "receipt_payload_sha256", "playback_authorized", "memory_authorized", "next_gate"],
  "properties": {
    "schema": {"const": "agent_bridge.story_bounded_render_receipt.v1"},
    "status": {"const": "bounded_render_machine_verified"},
    "authorization_id": {"type": "string", "minLength": 1},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_sha256": {"$ref": "#/$defs/sha256"},
    "segments": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/segment"}},
    "assembly": {"allOf": [{"$ref": "#/$defs/audio"}, {"type": "object", "required": ["audio_path", "gap_seconds"], "properties": {"audio_path": {"type": "string", "minLength": 1}, "gap_seconds": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 10}}}}]},
    "runtime_effects": {"const": {"created_output_directory": true, "loaded_model": true, "executed_onnx": true, "rendered_audio": true, "played_audio": false, "recorded_audio": false, "wrote_cache": false, "wrote_memory": false, "consumed_render_nonce": true}},
    "receipt_payload_sha256": {"$ref": "#/$defs/sha256"},
    "playback_authorized": {"const": false}, "memory_authorized": {"const": false},
    "next_gate": {"const": "separate_playback_authorization_or_render_review"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audio": {"type": "object", "required": ["sha256", "sample_rate_hz", "channels", "sample_width_bytes", "frames", "duration_seconds", "peak", "non_silent"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "sample_rate_hz": {"const": 24000}, "channels": {"const": 1}, "sample_width_bytes": {"const": 2}, "frames": {"type": "integer", "minimum": 1}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0}, "peak": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "non_silent": {"const": true}}},
    "segment": {"allOf": [{"$ref": "#/$defs/audio"}, {"type": "object", "required": ["index", "event_id", "cache_key", "speaker", "generated_codec_frames", "natural_eos", "audio_path"], "properties": {"index": {"type": "integer", "minimum": 0}, "event_id": {"type": "string", "minLength": 1}, "cache_key": {"$ref": "#/$defs/sha256"}, "speaker": {"type": "string", "minLength": 1}, "generated_codec_frames": {"type": "integer", "minimum": 1}, "natural_eos": {"const": true}, "audio_path": {"type": "string", "minLength": 1}}}]}
  }
}
