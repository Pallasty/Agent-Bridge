{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/story_plan.v1.json",
  "title": "Agent-Bridge Story Static Ingest Plan",
  "type": "object",
  "required": [
    "schema",
    "status",
    "command",
    "source",
    "selection",
    "chapters",
    "cast_registry",
    "relationships",
    "events",
    "review_queue",
    "voice_scene",
    "runtime_boundary"
  ],
  "properties": {
    "schema": { "const": "agent_bridge.story_plan.v1" },
    "status": { "const": "story_plan_reviewable" },
    "command": {
      "type": "object",
      "required": ["path", "start", "dry_run"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "start": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind"],
              "properties": { "kind": { "const": "from_start" } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "chapter"],
              "properties": {
                "kind": { "const": "chapter" },
                "chapter": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          ]
        },
        "dry_run": { "const": true }
      },
      "additionalProperties": false
    },
    "source": { "$ref": "#/$defs/source" },
    "selection": {
      "type": "object",
      "required": ["first_chapter", "selected_chapter_ids"],
      "properties": {
        "first_chapter": { "type": "integer", "minimum": 0 },
        "selected_chapter_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chapter" }
    },
    "cast_registry": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/character" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/extracted_event" }
    },
    "review_queue": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/review_item" }
    },
    "voice_scene": {
      "type": "object",
      "description": "Validated independently against voice_scene.schema.json and semantic rules."
    },
    "runtime_boundary": { "$ref": "#/$defs/runtime_boundary" }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "kind",
        "format",
        "uri",
        "sha256",
        "version",
        "encoding",
        "byte_length",
        "char_length"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "novel" },
        "format": { "enum": ["txt", "md", "markdown"] },
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1 },
        "encoding": { "const": "utf-8" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "char_length": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "source_span": {
      "type": "object",
      "required": [
        "source_id",
        "line_start",
        "line_end",
        "char_start",
        "char_end"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "char_start": { "type": "integer", "minimum": 0 },
        "char_end": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "required": [
        "chapter_id",
        "ordinal",
        "title",
        "selected",
        "source_span"
      ],
      "properties": {
        "chapter_id": { "$ref": "#/$defs/identifier" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "selected": { "type": "boolean" },
        "source_span": { "$ref": "#/$defs/source_span" }
      },
      "additionalProperties": false
    },
    "voice_profile": {
      "type": "object",
      "required": [
        "voice_profile_id",
        "speaker_id",
        "version",
        "backend",
        "model",
        "voice",
        "language",
        "audition_status"
      ],
      "properties": {
        "voice_profile_id": { "$ref": "#/$defs/identifier" },
        "speaker_id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "integer", "minimum": 1 },
        "backend": { "const": "unassigned" },
        "model": { "const": "unassigned" },
        "voice": { "const": "unassigned" },
        "language": { "type": "string", "minLength": 2 },
        "audition_status": { "const": "needs_review" }
      },
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "required": [
        "speaker_id",
        "kind",
        "display_name",
        "aliases",
        "identity_status",
        "voice_profile"
      ],
      "properties": {
        "speaker_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["narrator", "character"] },
        "display_name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "identity_status": {
          "enum": ["source_grounded", "needs_review"]
        },
        "voice_profile": { "$ref": "#/$defs/voice_profile" }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "relation_id",
        "subject",
        "predicate",
        "object",
        "confidence",
        "status",
        "source_span"
      ],
      "properties": {
        "relation_id": { "$ref": "#/$defs/identifier" },
        "subject": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "object": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "const": "needs_review" },
        "source_span": { "$ref": "#/$defs/source_span" }
      },
      "additionalProperties": false
    },
    "extracted_event": {
      "type": "object",
      "required": [
        "event_id",
        "summary",
        "confidence",
        "status",
        "source_span"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/identifier" },
        "summary": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "const": "needs_review" },
        "source_span": { "$ref": "#/$defs/source_span" }
      },
      "additionalProperties": false
    },
    "review_item": {
      "type": "object",
      "required": [
        "review_id",
        "kind",
        "subject_ref",
        "reason",
        "confidence",
        "status"
      ],
      "properties": {
        "review_id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": [
            "character_identity",
            "voice_audition",
            "chapter_boundary",
            "emotion"
          ]
        },
        "subject_ref": { "$ref": "#/$defs/identifier" },
        "reason": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "const": "needs_review" }
      },
      "additionalProperties": false
    },
    "runtime_boundary": {
      "type": "object",
      "required": [
        "emits_audio",
        "records_audio",
        "writes_memory",
        "writes_forum",
        "mutates_runtime",
        "downloads_models"
      ],
      "properties": {
        "emits_audio": { "const": false },
        "records_audio": { "const": false },
        "writes_memory": { "const": false },
        "writes_forum": { "const": false },
        "mutates_runtime": { "const": false },
        "downloads_models": { "const": false }
      },
      "additionalProperties": false
    }
  }
}
