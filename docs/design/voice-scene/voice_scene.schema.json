{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/voice_scene.v0.json",
  "title": "Agent-Bridge Voice Scene S0 Contract",
  "type": "object",
  "required": [
    "schema",
    "scene",
    "sources",
    "speakers",
    "voice_profiles",
    "branches",
    "timeline",
    "claims",
    "runtime_boundary"
  ],
  "properties": {
    "schema": { "const": "agent_bridge.voice_scene.v0" },
    "scene": { "$ref": "#/$defs/scene" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "speakers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/speaker" }
    },
    "voice_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/voice_profile" }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/branch" }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/timeline_event" }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "runtime_boundary": { "$ref": "#/$defs/runtime_boundary" }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scene": {
      "type": "object",
      "required": ["scene_id", "mode", "source_id", "canonical_branch_id"],
      "properties": {
        "scene_id": { "$ref": "#/$defs/identifier" },
        "mode": {
          "enum": ["story", "meeting", "agent_theater", "training", "other"]
        },
        "source_id": { "$ref": "#/$defs/identifier" },
        "canonical_branch_id": { "$ref": "#/$defs/identifier" },
        "policy_profile": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["source_id", "kind", "uri", "sha256", "version"],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["novel", "meeting_audio", "agent_transcript", "document"]
        },
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1 },
        "retention_policy": { "type": "string", "minLength": 1 },
        "consent_status": {
          "enum": ["not_applicable", "required", "confirmed", "revoked"]
        }
      },
      "additionalProperties": false
    },
    "speaker": {
      "type": "object",
      "required": [
        "speaker_id",
        "kind",
        "display_name",
        "aliases",
        "identity_status"
      ],
      "properties": {
        "speaker_id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["narrator", "character", "participant", "agent", "unknown"]
        },
        "display_name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "identity_status": {
          "enum": [
            "source_grounded",
            "human_confirmed",
            "provisional",
            "needs_review"
          ]
        }
      },
      "additionalProperties": false
    },
    "voice_profile": {
      "type": "object",
      "required": [
        "voice_profile_id",
        "speaker_id",
        "version",
        "backend",
        "model",
        "voice",
        "language",
        "audition_status"
      ],
      "properties": {
        "voice_profile_id": { "$ref": "#/$defs/identifier" },
        "speaker_id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "integer", "minimum": 1 },
        "backend": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "voice": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "style": { "type": "string" },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
        "audition_status": {
          "enum": ["needs_review", "human_confirmed", "rejected"]
        }
      },
      "additionalProperties": false
    },
    "branch": {
      "type": "object",
      "required": [
        "branch_id",
        "kind",
        "parent_branch_id",
        "fork_event_id"
      ],
      "properties": {
        "branch_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["canonical", "simulation", "interaction"] },
        "parent_branch_id": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "fork_event_id": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "source_ref": {
      "type": "object",
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "locator": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "utterance": {
      "type": "object",
      "required": ["speaker_id", "text", "language", "origin"],
      "properties": {
        "speaker_id": { "$ref": "#/$defs/identifier" },
        "text": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "origin": {
          "enum": ["source", "transcript", "translation", "generated"]
        },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "stability": { "enum": ["stable", "provisional"] }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["kind", "summary", "confidence"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "memory_event": {
      "type": "object",
      "required": ["kind", "subject_id", "summary"],
      "properties": {
        "kind": {
          "enum": [
            "canon",
            "character_knowledge",
            "interaction",
            "decision",
            "action_item"
          ]
        },
        "subject_id": { "$ref": "#/$defs/identifier" },
        "summary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "timeline_event": {
      "type": "object",
      "required": [
        "event_id",
        "sequence",
        "idempotency_key",
        "branch_id",
        "event_type"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "branch_id": { "$ref": "#/$defs/identifier" },
        "target_branch_id": { "$ref": "#/$defs/identifier" },
        "event_type": {
          "enum": ["utterance", "observation", "memory_event", "render_artifact"]
        },
        "source_ref": { "$ref": "#/$defs/source_ref" },
        "utterance": { "$ref": "#/$defs/utterance" },
        "observation": { "$ref": "#/$defs/observation" },
        "memory_event": { "$ref": "#/$defs/memory_event" },
        "render_artifact": { "$ref": "#/$defs/render_artifact" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "event_type": { "const": "utterance" } },
            "required": ["event_type"]
          },
          "then": { "required": ["utterance"] }
        },
        {
          "if": {
            "properties": { "event_type": { "const": "observation" } },
            "required": ["event_type"]
          },
          "then": { "required": ["observation"] }
        },
        {
          "if": {
            "properties": { "event_type": { "const": "memory_event" } },
            "required": ["event_type"]
          },
          "then": { "required": ["memory_event"] }
        },
        {
          "if": {
            "properties": { "event_type": { "const": "render_artifact" } },
            "required": ["event_type"]
          },
          "then": { "required": ["render_artifact"] }
        }
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "kind",
        "text",
        "branch_id",
        "evidence_refs",
        "derived_from_claim_ids",
        "confidence",
        "counter_evidence_refs"
      ],
      "properties": {
        "claim_id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": [
            "source_truth",
            "observation",
            "inference",
            "simulation_branch"
          ]
        },
        "text": { "type": "string", "minLength": 1 },
        "branch_id": { "$ref": "#/$defs/identifier" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "derived_from_claim_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "counter_evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "render_artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "status",
        "sha256",
        "verified_to",
        "not_verified"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["planned", "rendered", "verified", "failed"] },
        "sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "verified_to": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "not_verified": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtime_boundary": {
      "type": "object",
      "required": [
        "emits_audio",
        "records_audio",
        "writes_memory",
        "writes_forum",
        "mutates_runtime",
        "downloads_models"
      ],
      "properties": {
        "emits_audio": { "const": false },
        "records_audio": { "const": false },
        "writes_memory": { "const": false },
        "writes_forum": { "const": false },
        "mutates_runtime": { "const": false },
        "downloads_models": { "const": false }
      },
      "additionalProperties": false
    }
  }
}
