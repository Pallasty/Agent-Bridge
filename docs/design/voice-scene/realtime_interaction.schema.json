{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/story_realtime_turn.v1.json",
  "title": "Agent-Bridge S4 Realtime Story Interaction Receipt",
  "type": "object",
  "required": [
    "schema",
    "turn_id",
    "session_id",
    "status",
    "cursor_sequence",
    "capture",
    "transcript",
    "route",
    "response",
    "playback",
    "timeline",
    "overlap_detected",
    "retention",
    "memory_proposal"
  ],
  "properties": {
    "schema": { "const": "agent_bridge.story_realtime_turn.v1" },
    "turn_id": { "$ref": "#/$defs/identifier" },
    "session_id": { "$ref": "#/$defs/identifier" },
    "status": {
      "enum": ["completed", "response_rendered_output_gated"]
    },
    "cursor_sequence": { "type": "integer", "minimum": 0 },
    "capture": {
      "type": "object",
      "required": ["mode", "owner_authorized", "sha256", "duration_ms"],
      "properties": {
        "mode": { "const": "push_to_talk" },
        "owner_authorized": { "const": true },
        "sha256": { "$ref": "#/$defs/sha256" },
        "duration_ms": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "transcript": {
      "type": "object",
      "required": [
        "ok",
        "text",
        "language",
        "stability",
        "confidence",
        "source_audio_sha256"
      ],
      "properties": {
        "ok": { "const": true },
        "text": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "stability": { "enum": ["provisional", "stable"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_audio_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": ["character_id", "basis", "matched_text"],
      "properties": {
        "character_id": { "$ref": "#/$defs/identifier" },
        "basis": { "enum": ["explicit_name", "session_default"] },
        "matched_text": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "text",
        "claim_kind",
        "evidence_event_ids",
        "spoiler_blocked",
        "audio_emitted",
        "artifact_sha256",
        "backend",
        "model",
        "voice_profile_version",
        "human_audibility"
      ],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "claim_kind": { "enum": ["source_truth", "observation", "inference"] },
        "evidence_event_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "spoiler_blocked": { "type": "boolean" },
        "audio_emitted": { "type": "boolean" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "backend": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "voice_profile_version": { "type": "integer", "minimum": 1 },
        "human_audibility": {
          "enum": ["pending", "not_emitted", "confirmed", "rejected"]
        }
      },
      "additionalProperties": false
    },
    "playback": {
      "type": "object",
      "required": ["paused_at_ms", "resumed_at_ms"],
      "properties": {
        "paused_at_ms": { "type": "integer", "minimum": 0 },
        "resumed_at_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "array",
      "minItems": 8,
      "items": {
        "enum": [
          "story_playing",
          "story_paused",
          "capture_requested",
          "capture_complete",
          "asr_requested",
          "asr_complete",
          "character_routed",
          "knowledge_gate_complete",
          "spoiler_gate_complete",
          "tts_requested",
          "tts_complete",
          "response_emitted",
          "response_output_gated",
          "story_resumed"
        ]
      }
    },
    "overlap_detected": { "const": false },
    "retention": {
      "type": "object",
      "required": [
        "policy",
        "capture_retained",
        "transcript_retained",
        "withdrawal_available"
      ],
      "properties": {
        "policy": {
          "enum": ["none", "session", "durable_with_owner_review"]
        },
        "capture_retained": { "type": "boolean" },
        "transcript_retained": { "type": "boolean" },
        "withdrawal_available": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "memory_proposal": {
      "type": "object",
      "required": [
        "event_id",
        "kind",
        "branch_id",
        "target_branch_id",
        "character_id",
        "listener_text",
        "response_text",
        "evidence_event_ids",
        "idempotency_key",
        "writes_canon",
        "write_posture"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "interaction" },
        "branch_id": { "$ref": "#/$defs/identifier" },
        "target_branch_id": { "$ref": "#/$defs/identifier" },
        "character_id": { "$ref": "#/$defs/identifier" },
        "listener_text": { "type": "string", "minLength": 1 },
        "response_text": { "type": "string", "minLength": 1 },
        "evidence_event_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "writes_canon": { "const": false },
        "write_posture": { "const": "proposal_only_owner_review_required" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
