    "configuration": {"type": "object", "required": ["fragment_path", "fragment_sha256", "fixture_pilot_only", "installed"], "properties": {"fragment_path": {"type": "string", "minLength": 1}, "fragment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "fixture_pilot_only": {"const": true}, "installed": {"const": false}}, "additionalProperties": false},
