{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/story_render_manifest.v1.json",
  "title": "Agent-Bridge Story Offline Render Manifest",
  "type": "object",
  "required": [
    "schema",
    "status",
    "scene_id",
    "source_sha256",
    "source_version",
    "expected_event_sequence",
    "backend",
    "render_controls",
    "segments",
    "segment_summary",
    "chapter_artifact",
    "player_gate"
  ],
  "properties": {
    "schema": { "const": "agent_bridge.story_render_manifest.v1" },
    "status": { "const": "rendered_verified" },
    "scene_id": { "$ref": "#/$defs/identifier" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "source_version": { "type": "string", "minLength": 1 },
    "expected_event_sequence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "backend": { "$ref": "#/$defs/backend" },
    "render_controls": {
      "type": "object",
      "required": [
        "speed",
        "gain_db",
        "pause_ms",
        "normalization",
        "pitch"
      ],
      "properties": {
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
        "gain_db": { "type": "number", "minimum": -24, "maximum": 24 },
        "pause_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "normalization": { "const": "pcm16_target_rms_-20dbfs" },
        "pitch": { "const": "unsupported" }
      },
      "additionalProperties": false
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/segment" }
    },
    "segment_summary": {
      "type": "object",
      "required": ["count", "rendered", "cache_hits", "attempts"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "rendered": { "type": "integer", "minimum": 1 },
        "cache_hits": { "type": "integer", "minimum": 0 },
        "attempts": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "chapter_artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "duration_ms",
        "sample_rate",
        "channels",
        "verification",
        "human_audition"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "sample_rate": { "type": "integer", "minimum": 8000 },
        "channels": { "const": 1 },
        "verification": { "const": "machine_pcm_wav_integrity" },
        "human_audition": {
          "enum": ["pending", "confirmed", "rejected"]
        }
      },
      "additionalProperties": false
    },
    "player_gate": { "const": "explicit_owner_authorization_required" }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "backend": {
      "type": "object",
      "required": [
        "backend",
        "model_id",
        "model_sha256",
        "binary_sha256",
        "capabilities"
      ],
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_sha256": { "$ref": "#/$defs/sha256" },
        "binary_sha256": { "$ref": "#/$defs/sha256" },
        "capabilities": {
          "type": "object",
          "required": ["speed", "gain", "pause", "pitch"],
          "properties": {
            "speed": { "type": "boolean" },
            "gain": { "type": "boolean" },
            "pause": { "type": "boolean" },
            "pitch": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": [
        "event_id",
        "sequence",
        "cache_key",
        "path",
        "sha256",
        "duration_ms",
        "cached",
        "attempts",
        "voice_profile_id",
        "voice_profile_version",
        "backend",
        "model_id",
        "model_sha256",
        "binary_sha256",
        "voice",
        "pause_ms"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "cache_key": { "$ref": "#/$defs/sha256" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "cached": { "type": "boolean" },
        "attempts": { "type": "integer", "minimum": 0 },
        "voice_profile_id": { "$ref": "#/$defs/identifier" },
        "voice_profile_version": { "type": "integer", "minimum": 1 },
        "backend": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_sha256": { "$ref": "#/$defs/sha256" },
        "binary_sha256": { "$ref": "#/$defs/sha256" },
        "voice": { "type": "string", "minLength": 1 },
        "pause_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
