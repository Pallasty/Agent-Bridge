{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/story_command_integration_preflight.v1.json",
  "title": "Agent-Bridge story command integration preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "command",
    "provenance",
    "selection",
    "render_requests",
    "preflight_sha256",
    "execution_authorized",
    "runtime_effects",
    "next_gate"
  ],
  "properties": {
    "schema": {"const": "agent_bridge.story_command_integration_preflight.v1"},
    "status": {"const": "story_command_integration_preflight_reviewable"},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "source_path", "start", "chapter_number", "dry_run"],
      "properties": {
        "raw": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "start": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {"kind": {"const": "from_start"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "chapter"],
              "properties": {
                "kind": {"const": "chapter"},
                "chapter": {"type": "integer", "minimum": 1}
              }
            }
          ]
        },
        "chapter_number": {"type": "integer", "minimum": 1},
        "dry_run": {"const": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "mapping_sha256",
        "voice_plan_sha256",
        "model_inference_sha256",
        "continuity_receipt_status"
      ],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "mapping_sha256": {"$ref": "#/$defs/sha256"},
        "voice_plan_sha256": {"$ref": "#/$defs/sha256"},
        "model_inference_sha256": {"$ref": "#/$defs/sha256"},
        "continuity_receipt_status": {"const": "owner_accepted"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_segments",
        "excluded_earlier_segments",
        "excluded_later_segments",
        "assembly_gap_seconds",
        "preceding_scene_gap_seconds"
      ],
      "properties": {
        "selected_segments": {"type": "integer", "minimum": 1},
        "excluded_earlier_segments": {"type": "integer", "minimum": 0},
        "excluded_later_segments": {"type": "integer", "minimum": 0},
        "assembly_gap_seconds": {
          "type": "array",
          "items": {"type": "number", "minimum": 0, "maximum": 3}
        },
        "preceding_scene_gap_seconds": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "render_requests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/render_request"}
    },
    "preflight_sha256": {"$ref": "#/$defs/sha256"},
    "execution_authorized": {"const": false},
    "runtime_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered_story_command",
        "loaded_model",
        "executed_onnx",
        "rendered_audio",
        "played_audio",
        "wrote_memory",
        "wrote_cache"
      ],
      "properties": {
        "registered_story_command": {"const": false},
        "loaded_model": {"const": false},
        "executed_onnx": {"const": false},
        "rendered_audio": {"const": false},
        "played_audio": {"const": false},
        "wrote_memory": {"const": false},
        "wrote_cache": {"const": false}
      }
    },
    "next_gate": {"const": "story_command_static_registration_contract"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "render_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_index",
        "event_id",
        "voice_plan_sha256",
        "text",
        "qwen_speaker",
        "style_instruction",
        "language",
        "frame_cap",
        "voice_profile_version",
        "cache_key"
      ],
      "properties": {
        "segment_index": {"type": "integer", "minimum": 0},
        "event_id": {"type": "string", "minLength": 1},
        "voice_plan_sha256": {"$ref": "#/$defs/sha256"},
        "text": {"type": "string", "minLength": 1},
        "qwen_speaker": {"type": "string", "minLength": 1},
        "style_instruction": {"type": "string", "minLength": 1},
        "language": {"const": "Chinese"},
        "frame_cap": {"type": "integer", "minimum": 1},
        "voice_profile_version": {"type": "integer", "minimum": 1},
        "cache_key": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
