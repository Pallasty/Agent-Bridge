{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/voice_offline_lock_contract.schema.json",
  "title": "Agent-Bridge voice offline lock contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "inputs", "dependency_lock", "workspace", "commands",
    "readiness", "blockers", "next_gate", "runtime_effects"
  ],
  "properties": {
    "schema": {"const": "agent_bridge.voice_offline_lock_contract.v1"},
    "status": {
      "const": "direct_lock_contract_ready_wheelhouse_pending"
    },
    "inputs": {"type": "object"},
    "dependency_lock": {
      "type": "object",
      "required": [
        "python_abi", "platform", "critical_direct_pins",
        "critical_direct_pins_exact", "transitive_lock_complete",
        "wheel_hash_ledger_complete", "excluded"
      ],
      "properties": {
        "critical_direct_pins_exact": {"const": true},
        "transitive_lock_complete": {"const": false},
        "wheel_hash_ledger_complete": {"const": false}
      }
    },
    "workspace": {"type": "object"},
    "commands": {
      "type": "object",
      "required": ["offline_install_argv_template", "converter_argv"],
      "properties": {
        "offline_install_argv_template": {
          "type": "array", "items": {"type": "string"}
        },
        "converter_argv": {"type": "null"}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offline_install_ready", "converter_execution_ready"],
      "properties": {
        "offline_install_ready": {"const": false},
        "converter_execution_ready": {"const": false}
      }
    },
    "blockers": {
      "type": "array", "items": {"type": "string"}, "uniqueItems": true
    },
    "next_gate": {"const": "materialize_and_hash_offline_wheelhouse"},
    "runtime_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used_network", "created_directories", "created_external_files",
        "installed_packages", "loaded_source_model", "executed_converter",
        "executed_quantizer", "created_onnx", "used_gpu", "played_audio"
      ],
      "properties": {
        "used_network": {"const": false},
        "created_directories": {"const": false},
        "created_external_files": {"const": false},
        "installed_packages": {"const": false},
        "loaded_source_model": {"const": false},
        "executed_converter": {"const": false},
        "executed_quantizer": {"const": false},
        "created_onnx": {"const": false},
        "used_gpu": {"const": false},
        "played_audio": {"const": false}
      }
    }
  }
}
