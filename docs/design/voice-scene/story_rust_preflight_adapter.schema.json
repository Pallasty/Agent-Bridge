{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/story_rust_preflight_adapter.v1.json",
  "title": "Agent-Bridge Rust story preflight adapter parity receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "evidence", "vectors", "parity", "negative_controls", "scope", "runtime_effects", "next_gate"],
  "properties": {
    "schema": {"const": "agent_bridge.story_rust_preflight_adapter.v1"},
    "status": {"const": "rust_story_preflight_adapter_parity_verified"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust_module_path", "rust_module_sha256", "rust_test_path", "rust_test_sha256", "python_preflight_path", "python_preflight_sha256", "accepted_preflight_path", "accepted_preflight_sha256"],
      "properties": {
        "rust_module_path": {"type": "string", "minLength": 1},
        "rust_module_sha256": {"$ref": "#/$defs/sha256"},
        "rust_test_path": {"type": "string", "minLength": 1},
        "rust_test_sha256": {"$ref": "#/$defs/sha256"},
        "python_preflight_path": {"type": "string", "minLength": 1},
        "python_preflight_sha256": {"$ref": "#/$defs/sha256"},
        "accepted_preflight_path": {"type": "string", "minLength": 1},
        "accepted_preflight_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_2_segments", "from_start_segments", "preflight_sha256"],
      "properties": {
        "chapter_2_segments": {"const": 3},
        "from_start_segments": {"const": 4},
        "preflight_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "parity": {"type": "object", "minProperties": 6, "additionalProperties": {"const": true}},
    "negative_controls": {"type": "object", "minProperties": 4, "additionalProperties": {"const": true}},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_exported", "mcp_registered", "python_embedded", "execution_authorized"],
      "properties": {
        "module_exported": {"const": false},
        "mcp_registered": {"const": false},
        "python_embedded": {"const": false},
        "execution_authorized": {"const": false}
      }
    },
    "runtime_effects": {"type": "object", "minProperties": 1, "additionalProperties": {"const": false}},
    "next_gate": {"const": "owner_authorized_rust_story_registration_review"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
