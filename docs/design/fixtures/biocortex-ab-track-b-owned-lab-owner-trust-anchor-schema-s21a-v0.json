{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_bridge.memory_temporal_owned_lab_owner_trust_anchor_s21a.v0",
  "title": "Agent-Bridge S21A independently installed owner trust anchor",
  "description": "Closed trust-anchor contract for the new S21A audience. The repository fixture is a public KAT that is explicitly not installed and cannot authenticate an owner decision. A real test_only=false anchor rejects both the repository public KAT key identifier and its public key material.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packet_kind", "canonicalization", "hashing_contract", "anchor_state", "test_only", "synthetic", "audience", "owner_identity", "key_binding", "trust_policy", "anchor_document_sha256", "nonclaims"],
  "properties": {
    "schema": {"const": "agent_bridge.memory_temporal_owned_lab_owner_trust_anchor_s21a.v0"},
    "packet_kind": {"const": "S21A_OWNER_TRUST_ANCHOR"},
    "canonicalization": {"const": "AB_RESTRICTED_CANONICAL_JSON_S21A_V1_COMPACT_SORTED_KEYS_ASCII_VALUES_NO_FLOAT"},
    "hashing_contract": {"$ref": "#/$defs/hashing_contract"},
    "anchor_state": {"enum": ["SYNTHETIC_PUBLIC_KAT_NOT_INSTALLED", "INSTALLED_OUT_OF_BAND_CALLER_PINNED"]},
    "test_only": {"type": "boolean"},
    "synthetic": {"type": "boolean"},
    "audience": {"const": "agent-bridge/biocortex/owned-lab/s21a/final-refreeze-owner-review/v1"},
    "owner_identity": {"$ref": "#/$defs/owner_identity"},
    "key_binding": {"$ref": "#/$defs/key_binding"},
    "trust_policy": {"$ref": "#/$defs/trust_policy"},
    "anchor_document_sha256": {"$ref": "#/$defs/sha256"},
    "nonclaims": {"$ref": "#/$defs/nonclaims"}
  },
  "allOf": [
    {
      "if": {"properties": {"test_only": {"const": true}}, "required": ["test_only"]},
      "then": {
        "properties": {
          "synthetic": {"const": true},
          "anchor_state": {"const": "SYNTHETIC_PUBLIC_KAT_NOT_INSTALLED"},
          "owner_identity": {
            "properties": {
              "identity_verified_out_of_band": {"const": false},
              "owner_identity_verification_receipt_sha256": {"type": "null"}
            }
          },
          "trust_policy": {
            "properties": {
              "installed_out_of_band": {"const": false},
              "pinned_by_independent_caller": {"const": false},
              "installation_receipt_sha256": {"type": "null"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "synthetic": {"const": false},
          "anchor_state": {"const": "INSTALLED_OUT_OF_BAND_CALLER_PINNED"},
          "owner_identity": {
            "properties": {
              "identity_verified_out_of_band": {"const": true},
              "owner_identity_verification_receipt_sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "key_binding": {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "key_id": {"const": "s21a-synthetic-public-kat-v1"}
                  },
                  "required": ["key_id"]
                },
                {
                  "properties": {
                    "public_key_hex": {"const": "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"}
                  },
                  "required": ["public_key_hex"]
                }
              ]
            }
          },
          "trust_policy": {
            "properties": {
              "installed_out_of_band": {"const": true},
              "pinned_by_independent_caller": {"const": true},
              "installation_receipt_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "hashing_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "canonicalization", "digest_domain", "digest_framing", "hash_scope", "self_hash_field", "self_hash_field_excluded", "repository_framing_lf_excluded", "cross_field_semantic_validation_required", "candidate_reported_matches_authoritative"],
      "properties": {
        "hash_algorithm": {"const": "SHA-256"},
        "canonicalization": {"const": "AB_RESTRICTED_CANONICAL_JSON_S21A_V1_COMPACT_SORTED_KEYS_ASCII_VALUES_NO_FLOAT"},
        "digest_domain": {"const": "agent-bridge/biocortex/owned-lab/s21a/owner-trust-anchor-document/v1"},
        "digest_framing": {"const": "U32BE_DOMAIN_LENGTH_DOMAIN_U64BE_CANONICAL_PAYLOAD_LENGTH_CANONICAL_PAYLOAD"},
        "hash_scope": {"const": "ENTIRE_PACKET_EXCEPT_ANCHOR_DOCUMENT_SHA256"},
        "self_hash_field": {"const": "anchor_document_sha256"},
        "self_hash_field_excluded": {"const": true},
        "repository_framing_lf_excluded": {"const": true},
        "cross_field_semantic_validation_required": {"const": true},
        "candidate_reported_matches_authoritative": {"const": false}
      }
    },
    "owner_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_identity_sha256", "owner_role", "identity_verified_out_of_band", "owner_identity_verification_receipt_sha256"],
      "properties": {
        "owner_identity_sha256": {"$ref": "#/$defs/sha256"},
        "owner_role": {"const": "AGENT_BRIDGE_OWNED_LAB_EXECUTION_OWNER"},
        "identity_verified_out_of_band": {"type": "boolean"},
        "owner_identity_verification_receipt_sha256": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "key_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "key_version", "public_key_hex", "legacy_s19_key_reuse_allowed", "private_key_present_in_repository"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$"},
        "key_version": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "public_key_hex": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
        "legacy_s19_key_reuse_allowed": {"const": false},
        "private_key_present_in_repository": {"const": false}
      }
    },
    "trust_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_policy_sha256", "minimum_revocation_epoch", "installed_out_of_band", "pinned_by_independent_caller", "installation_receipt_sha256", "candidate_carried_key_is_trusted"],
      "properties": {
        "trust_policy_sha256": {"$ref": "#/$defs/sha256"},
        "minimum_revocation_epoch": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "installed_out_of_band": {"type": "boolean"},
        "pinned_by_independent_caller": {"type": "boolean"},
        "installation_receipt_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "candidate_carried_key_is_trusted": {"const": false}
      }
    },
    "nonclaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_is_owner_signature", "anchor_is_execution_capability", "public_kat_is_installed_anchor", "schema_conformance_establishes_trust", "side_effects_unlocked"],
      "properties": {
        "anchor_is_owner_signature": {"const": false},
        "anchor_is_execution_capability": {"const": false},
        "public_kat_is_installed_anchor": {"const": false},
        "schema_conformance_establishes_trust": {"const": false},
        "side_effects_unlocked": {"const": "NONE"}
      }
    }
  }
}
