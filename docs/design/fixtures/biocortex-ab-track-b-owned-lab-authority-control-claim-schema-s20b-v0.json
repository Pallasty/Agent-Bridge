        "SYNTHETIC_KAT_NON_LIVE_CLAIM_PACKET",
        "REGISTERED_COMMITTED",
        "LEDGER_AUTHORIZED_UNCLAIMED",
        "LEDGER_CONSUMED_FOR_EXACT_RUN",
        "KNOWN_NOT_COMMITTED_TERMINAL",
        "COMMITTED_PERMIT_ISSUED",
        "COMMITTED_PRE_PERMIT_CRASH_TERMINAL",
        "UNKNOWN_OUTCOME_TERMINAL_HARD_LOCK"
      ]
    },
    "authorization_binding": {"$ref": "#/$defs/authorization_binding"},
    "claim_key_binding": {"$ref": "#/$defs/claim_key_binding"},
    "assignment_binding": {"$ref": "#/$defs/assignment_binding"},
    "registration": {"$ref": "#/$defs/nullable_registration"},
    "ledger_row": {"$ref": "#/$defs/nullable_ledger_row"},
    "claim_attempt": {"$ref": "#/$defs/nullable_claim_attempt"},
    "same_transaction_control": {"$ref": "#/$defs/nullable_same_transaction_control"},
    "commit_outcome": {"$ref": "#/$defs/nullable_commit_outcome"},
    "permit_outcome": {"$ref": "#/$defs/nullable_permit_outcome"},
    "parent_bindings": {"$ref": "#/$defs/parent_bindings"},
    "claim_packet_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_validation": {"$ref": "#/$defs/semantic_validation"},
    "nonclaims": {"$ref": "#/$defs/nonclaims"}
  },
  "allOf": [
    {
      "if": {"properties": {"test_only": {"const": true}}, "required": ["test_only"]},
      "then": {
        "properties": {
          "synthetic": {"const": true},
          "claim_packet_state": {"const": "SYNTHETIC_KAT_NON_LIVE_CLAIM_PACKET"}
        }
      },
      "else": {"properties": {"synthetic": {"const": false}}}
    },
    {
      "if": {"properties": {"packet_kind": {"const": "S20B_AUTHORIZATION_REGISTRATION_RECEIPT"}}, "required": ["packet_kind"]},
      "then": {
        "properties": {
          "hashing_contract": {"properties": {"digest_domain": {"const": "agent-bridge/biocortex/owned-lab/s20b/authorization-registration-receipt/v1"}}},
          "registration": {"$ref": "#/$defs/registration"},
          "ledger_row": {"type": "null"},
          "claim_attempt": {"type": "null"},
          "same_transaction_control": {"type": "null"},
          "commit_outcome": {"type": "null"},
          "permit_outcome": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"packet_kind": {"const": "S20B_AUTHORITY_CONTROL_LEDGER_ROW"}}, "required": ["packet_kind"]},
      "then": {
        "properties": {
          "hashing_contract": {"properties": {"digest_domain": {"const": "agent-bridge/biocortex/owned-lab/s20b/authority-control-ledger-row/v1"}}},
          "registration": {"type": "null"},
          "ledger_row": {"$ref": "#/$defs/ledger_row"},
          "claim_attempt": {"type": "null"},
          "same_transaction_control": {"type": "null"},
          "commit_outcome": {"type": "null"},
          "permit_outcome": {"type": "null"}
        }
      }
    },
    {
