{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_bridge.memory_temporal_owned_lab_authority_control_claim_s20b.v0",
  "title": "Agent-Bridge S20B phase-separated authority-control claim packets",
  "description": "Closed non-live replacement for S19 registration, ledger-row, and claim-outcome packets. Unknown COMMIT outcomes and post-commit/pre-permit crashes are truthful absorbing states. Database rows bind transition cores, not a self-referential final claim digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "packet_kind", "canonicalization", "hashing_contract", "test_only",
    "synthetic", "claim_packet_state", "authorization_binding", "claim_key_binding",
    "assignment_binding", "registration", "ledger_row", "claim_attempt",
    "same_transaction_control", "commit_outcome", "permit_outcome", "parent_bindings",
    "claim_packet_sha256", "semantic_validation", "nonclaims"
  ],
  "properties": {
    "schema": {"const": "agent_bridge.memory_temporal_owned_lab_authority_control_claim_s20b.v0"},
    "packet_kind": {
      "enum": [
        "S20B_AUTHORIZATION_REGISTRATION_RECEIPT",
        "S20B_AUTHORITY_CONTROL_LEDGER_ROW",
        "S20B_SINGLE_USE_CLAIM_OUTCOME_RECEIPT"
      ]
    },
    "canonicalization": {"const": "AB_RESTRICTED_CANONICAL_JSON_S20B_V1_COMPACT_SORTED_KEYS_ASCII_VALUES_NO_FLOAT"},
