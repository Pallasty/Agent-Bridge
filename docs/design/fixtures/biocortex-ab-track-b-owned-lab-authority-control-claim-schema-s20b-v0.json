          "commit_outcome": {"$ref": "#/$defs/commit_outcome"},
          "permit_outcome": {"$ref": "#/$defs/permit_outcome"}
        }
      }
    },
    {
      "if": {"properties": {"claim_packet_state": {"const": "KNOWN_NOT_COMMITTED_TERMINAL"}}, "required": ["claim_packet_state"]},
      "then": {
        "properties": {
          "commit_outcome": {
            "properties": {
              "acknowledgement_state": {"const": "KNOWN_NOT_COMMITTED"},
              "affected_rows": {"const": 0},
              "row_mutation_state": {"const": "UNCHANGED_AUTHORIZED_UNCLAIMED"},
              "post_database_content_root_sha256": {"type": "null"},
              "external_checkpoint_receipt_sha256": {"type": "null"},
              "terminal_hard_lock": {"const": true}
            }
          },
          "permit_outcome": {
            "properties": {
              "permit_eligible_after_commit": {"const": false},
              "process_local_affine_permit_issued": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"claim_packet_state": {"const": "COMMITTED_PERMIT_ISSUED"}}, "required": ["claim_packet_state"]},
      "then": {
        "properties": {
          "commit_outcome": {
            "properties": {
              "acknowledgement_state": {"const": "COMMITTED"},
              "affected_rows": {"const": 1},
              "row_mutation_state": {"const": "CONSUMED_FOR_EXACT_RUN"},
              "post_database_content_root_sha256": {"$ref": "#/$defs/sha256"},
              "external_checkpoint_receipt_sha256": {"$ref": "#/$defs/sha256"},
              "terminal_hard_lock": {"const": false}
            }
          },
          "permit_outcome": {
            "properties": {
              "permit_eligible_after_commit": {"const": true},
              "process_local_affine_permit_issued": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"claim_packet_state": {"const": "COMMITTED_PRE_PERMIT_CRASH_TERMINAL"}}, "required": ["claim_packet_state"]},
      "then": {
        "properties": {
          "commit_outcome": {
            "properties": {
              "acknowledgement_state": {"const": "COMMITTED"},
              "affected_rows": {"const": 1},
              "row_mutation_state": {"const": "CONSUMED_FOR_EXACT_RUN"},
              "post_database_content_root_sha256": {"$ref": "#/$defs/sha256"},
              "external_checkpoint_receipt_sha256": {"$ref": "#/$defs/sha256"},
              "terminal_hard_lock": {"const": true}
            }
          },
          "permit_outcome": {
            "properties": {
              "permit_eligible_after_commit": {"const": true},
              "process_local_affine_permit_issued": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"claim_packet_state": {"const": "UNKNOWN_OUTCOME_TERMINAL_HARD_LOCK"}}, "required": ["claim_packet_state"]},
      "then": {
        "properties": {
          "commit_outcome": {
            "properties": {
              "acknowledgement_state": {"const": "UNKNOWN"},
              "affected_rows": {"type": "null"},
              "row_mutation_state": {"const": "UNKNOWN"},
              "post_database_content_root_sha256": {"type": "null"},
              "external_checkpoint_receipt_sha256": {"type": "null"},
              "terminal_hard_lock": {"const": true}
            }
          },
          "permit_outcome": {
            "properties": {
              "permit_eligible_after_commit": {"const": false},
              "process_local_affine_permit_issued": {"const": false}
            }
          }
        }
      }
    }
  ],
