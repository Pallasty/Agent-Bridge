{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_bridge.biocortex.track_b.t22_a1.runtime_credential_manifest.v1",
  "title": "BioCortex Track B T22-A1 runtime credential manifest",
  "description": "Private exact mTLS credential-source manifest. It contains paths and digests, never private key material, and is read only after exact owner execution authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packet_kind", "hashing_contract", "run_id", "source_commit", "private_endpoint_manifest_sha256", "ca", "coordinator", "domains", "coordinator_runtime_signing_key", "mutual_tls_required", "certificate_chain_and_key_match_verification_required", "certificate_valid_through_execution_expiry_required", "ambient_credential_discovery_allowed", "credential_paths_in_repository_allowed", "private_key_material_embedded", "content_sha256"],
  "properties": {
    "schema": {"const": "agent_bridge.biocortex.track_b.t22_a1.runtime_credential_manifest.v1"},
    "packet_kind": {"const": "T22_A1_PRIVATE_RUNTIME_CREDENTIAL_MANIFEST"},
    "hashing_contract": {"$ref": "#/$defs/hashing_contract"},
    "run_id": {"$ref": "#/$defs/run_id"},
    "source_commit": {"$ref": "#/$defs/git_oid"},
    "private_endpoint_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "ca": {"$ref": "#/$defs/ca"},
    "coordinator": {"allOf": [{"$ref": "#/$defs/credential"}, {"properties": {"identity": {"const": "coordinator"}}}]},
    "domains": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/credential"}, {"properties": {"identity": {"const": "domain-1"}}}]},
        {"allOf": [{"$ref": "#/$defs/credential"}, {"properties": {"identity": {"const": "domain-2"}}}]},
        {"allOf": [{"$ref": "#/$defs/credential"}, {"properties": {"identity": {"const": "domain-3"}}}]}
      ],
      "items": false
    },
    "coordinator_runtime_signing_key": {"$ref": "#/$defs/runtime_signing_key"},
    "mutual_tls_required": {"const": true},
    "certificate_chain_and_key_match_verification_required": {"const": true},
    "certificate_valid_through_execution_expiry_required": {"const": true},
    "ambient_credential_discovery_allowed": {"const": false},
    "credential_paths_in_repository_allowed": {"const": false},
    "private_key_material_embedded": {"const": false},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "pattern": "^t22-a1-[0-9]{8}T[0-9]{6}\\.[0-9]{6}z-[0-9a-f]{12}$"},
    "absolute_path": {"type": "string", "pattern": "^/", "maxLength": 4096},
    "utc_time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "hashing_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "canonicalization", "digest_domain", "hash_scope", "self_hash_field", "self_hash_field_excluded", "cross_field_semantic_validation_required"],
      "properties": {
        "hash_algorithm": {"const": "SHA-256"},
        "canonicalization": {"const": "COMPACT_SORTED_KEYS_UTF8_JSON_NO_FLOAT"},
        "digest_domain": {"const": "agent-bridge/biocortex/track-b/t22-a1/runtime-credential-manifest/v1"},
        "hash_scope": {"const": "ENTIRE_PACKET_EXCEPT_CONTENT_SHA256"},
        "self_hash_field": {"const": "content_sha256"},
        "self_hash_field_excluded": {"const": true},
        "cross_field_semantic_validation_required": {"const": true}
      }
    },
    "ca": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_path", "certificate_sha256", "spki_sha256", "self_signed_private_run_ca", "private_key_path_present"],
      "properties": {
        "certificate_path": {"$ref": "#/$defs/absolute_path"},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "spki_sha256": {"$ref": "#/$defs/sha256"},
        "self_signed_private_run_ca": {"const": true},
        "private_key_path_present": {"const": false}
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "certificate_path", "private_key_path", "certificate_sha256", "spki_sha256", "issuer_spki_sha256", "not_after", "extended_key_usage", "private_key_file_mode", "private_key_export_allowed"],
      "properties": {
        "identity": {"enum": ["coordinator", "domain-1", "domain-2", "domain-3"]},
        "certificate_path": {"$ref": "#/$defs/absolute_path"},
        "private_key_path": {"$ref": "#/$defs/absolute_path"},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "spki_sha256": {"$ref": "#/$defs/sha256"},
        "issuer_spki_sha256": {"$ref": "#/$defs/sha256"},
        "not_after": {"$ref": "#/$defs/utc_time"},
        "extended_key_usage": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["TLS_WEB_CLIENT_AUTHENTICATION", "TLS_WEB_SERVER_AUTHENTICATION"]}},
        "private_key_file_mode": {"const": "0600"},
        "private_key_export_allowed": {"const": false}
      }
    },
    "runtime_signing_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "public_key_path", "private_key_path", "public_key_sha256", "signature_scheme", "request_signature_namespace", "private_key_file_mode", "private_key_export_allowed"],
      "properties": {
        "identity": {"const": "coordinator-runtime"},
        "public_key_path": {"$ref": "#/$defs/absolute_path"},
        "private_key_path": {"$ref": "#/$defs/absolute_path"},
        "public_key_sha256": {"$ref": "#/$defs/sha256"},
        "signature_scheme": {"const": "OPENSSH_SSHSIG_ED25519"},
        "request_signature_namespace": {"const": "agent-bridge-t22-a1-coordinator-message-v1"},
        "private_key_file_mode": {"const": "0600"},
        "private_key_export_allowed": {"const": false}
      }
    }
  }
}
