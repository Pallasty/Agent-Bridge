{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_bridge.biocortex.track_b.t22_a1.domain_runtime_readiness.v1",
  "title": "BioCortex Track B T22-A1 private domain runtime readiness",
  "description": "Private, detached-domain-signed binding of exact host-local tools, roots, ports, placed credentials and execution boundaries. Raw instances are forbidden from the repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packet_kind", "hashing_contract", "run_id", "source_commit", "domain_id", "collected_at", "expires_at", "bindings", "host_binding", "endpoint_binding", "toolchain", "local_paths", "credential_placement", "process_policy", "signature_binding", "collection_effects", "claims", "content_sha256"],
  "properties": {
    "schema": {"const": "agent_bridge.biocortex.track_b.t22_a1.domain_runtime_readiness.v1"},
    "packet_kind": {"const": "T22_A1_PRIVATE_DOMAIN_RUNTIME_READINESS"},
    "hashing_contract": {"$ref": "#/$defs/hashing_contract"},
    "run_id": {"$ref": "#/$defs/run_id"},
    "source_commit": {"$ref": "#/$defs/git_oid"},
    "domain_id": {"enum": ["domain-1", "domain-2", "domain-3"]},
    "collected_at": {"$ref": "#/$defs/utc_time"},
    "expires_at": {"$ref": "#/$defs/utc_time"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "host_binding": {"$ref": "#/$defs/host_binding"},
    "endpoint_binding": {"$ref": "#/$defs/endpoint_binding"},
    "toolchain": {"$ref": "#/$defs/toolchain"},
    "local_paths": {"$ref": "#/$defs/local_paths"},
    "credential_placement": {"$ref": "#/$defs/credential_placement"},
    "process_policy": {"$ref": "#/$defs/process_policy"},
    "signature_binding": {"$ref": "#/$defs/signature_binding"},
    "collection_effects": {"$ref": "#/$defs/collection_effects"},
    "claims": {"$ref": "#/$defs/claims"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "pattern": "^t22-a1-[0-9]{8}T[0-9]{6}\\.[0-9]{6}z-[0-9a-f]{12}$"},
    "absolute_path": {"type": "string", "pattern": "^/", "maxLength": 4096},
    "utc_time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "hashing_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "canonicalization", "digest_domain", "hash_scope", "self_hash_field", "self_hash_field_excluded", "detached_domain_signature_covers_complete_canonical_packet", "cross_field_semantic_validation_required"],
      "properties": {
        "hash_algorithm": {"const": "SHA-256"},
        "canonicalization": {"const": "COMPACT_SORTED_KEYS_UTF8_JSON_NO_FLOAT"},
        "digest_domain": {"const": "agent-bridge/biocortex/track-b/t22-a1/domain-runtime-readiness/v1"},
        "hash_scope": {"const": "ENTIRE_PACKET_EXCEPT_CONTENT_SHA256"},
        "self_hash_field": {"const": "content_sha256"},
        "self_hash_field_excluded": {"const": true},
        "detached_domain_signature_covers_complete_canonical_packet": {"const": true},
        "cross_field_semantic_validation_required": {"const": true}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_decision_proposal_sha256", "admission_contract_sha256", "domain_attestation_packet_sha256", "owner_countersigned_attestation_set_receipt_sha256", "private_endpoint_manifest_content_sha256", "runtime_credential_manifest_content_sha256", "runtime_preparation_terminal_receipt_sha256"],
      "properties": {
        "owner_decision_proposal_sha256": {"$ref": "#/$defs/sha256"},
        "admission_contract_sha256": {"$ref": "#/$defs/sha256"},
        "domain_attestation_packet_sha256": {"$ref": "#/$defs/sha256"},
        "owner_countersigned_attestation_set_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "private_endpoint_manifest_content_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_credential_manifest_content_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_preparation_terminal_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "host_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "operating_system", "architecture", "machine_id_sha256", "hardware_identity_sha256", "boot_id_sha256"],
      "properties": {
        "hostname": {"type": "string", "minLength": 1, "maxLength": 255},
        "operating_system": {"enum": ["LINUX", "MACOS"]},
        "architecture": {"enum": ["X86_64", "AARCH64"]},
        "machine_id_sha256": {"$ref": "#/$defs/sha256"},
        "hardware_identity_sha256": {"$ref": "#/$defs/sha256"},
        "boot_id_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "endpoint_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay_ip", "agent_control_port", "etcd_client_port", "etcd_peer_port", "openbao_api_port", "openbao_cluster_port", "port_set_sha256", "bind_exact_overlay_ip_only", "public_listener_allowed"],
      "properties": {
        "overlay_ip": {"type": "string", "format": "ipv4"},
        "agent_control_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "etcd_client_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "etcd_peer_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "openbao_api_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "openbao_cluster_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "port_set_sha256": {"$ref": "#/$defs/sha256"},
        "bind_exact_overlay_ip_only": {"const": true},
        "public_listener_allowed": {"const": false}
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256", "bytes", "executable_by_owner", "version_output_sha256"],
      "properties": {
        "name": {"enum": ["python3", "etcd", "etcdctl", "bao", "openssl", "ssh-keygen"]},
        "path": {"$ref": "#/$defs/absolute_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "executable_by_owner": {"const": true},
        "version_output_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pinned_tool_receipt_path", "pinned_tool_receipt_sha256", "executables", "all_paths_absolute", "all_hashes_recomputed_locally", "ambient_path_lookup_allowed"],
      "properties": {
        "pinned_tool_receipt_path": {"$ref": "#/$defs/absolute_path"},
        "pinned_tool_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "executables": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/executable"}},
        "all_paths_absolute": {"const": true},
        "all_hashes_recomputed_locally": {"const": true},
        "ambient_path_lookup_allowed": {"const": false}
      }
    },
    "local_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_private_root", "private_data_root_sha256", "etcd_data_dir", "openbao_data_dir", "owned_logs_dir", "domain_evidence_dir", "execution_reservation_dir", "all_paths_outside_repository", "directory_mode"],
      "properties": {
        "domain_private_root": {"$ref": "#/$defs/absolute_path"},
        "private_data_root_sha256": {"$ref": "#/$defs/sha256"},
        "etcd_data_dir": {"$ref": "#/$defs/absolute_path"},
        "openbao_data_dir": {"$ref": "#/$defs/absolute_path"},
        "owned_logs_dir": {"$ref": "#/$defs/absolute_path"},
        "domain_evidence_dir": {"$ref": "#/$defs/absolute_path"},
        "execution_reservation_dir": {"$ref": "#/$defs/absolute_path"},
        "all_paths_outside_repository": {"const": true},
        "directory_mode": {"const": "0700"}
      }
    },
    "placed_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_path", "private_key_path", "certificate_sha256", "spki_sha256", "private_key_spki_sha256", "private_key_file_mode", "certificate_private_key_match_verified"],
      "properties": {
        "certificate_path": {"$ref": "#/$defs/absolute_path"},
        "private_key_path": {"$ref": "#/$defs/absolute_path"},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "spki_sha256": {"$ref": "#/$defs/sha256"},
        "private_key_spki_sha256": {"$ref": "#/$defs/sha256"},
        "private_key_file_mode": {"const": "0600"},
        "certificate_private_key_match_verified": {"const": true}
      }
    },
    "coordinator_material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_identity", "runtime_public_key_path", "runtime_private_key_path", "runtime_public_key_sha256", "runtime_private_key_file_mode", "runtime_key_pair_verified"],
      "properties": {
        "client_identity": {"$ref": "#/$defs/placed_identity"},
        "runtime_public_key_path": {"$ref": "#/$defs/absolute_path"},
        "runtime_private_key_path": {"$ref": "#/$defs/absolute_path"},
        "runtime_public_key_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_private_key_file_mode": {"const": "0600"},
        "runtime_key_pair_verified": {"const": true}
      }
    },
    "coordinator_trust_material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_path", "certificate_sha256", "spki_sha256", "runtime_public_key_path", "runtime_public_key_sha256"],
      "properties": {
        "certificate_path": {"$ref": "#/$defs/absolute_path"},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "spki_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_public_key_path": {"$ref": "#/$defs/absolute_path"},
        "runtime_public_key_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "credential_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ca_certificate_path", "ca_certificate_sha256", "domain_identity", "domain_operator_public_key_path", "domain_operator_private_key_path", "domain_operator_public_key_sha256", "domain_operator_private_key_file_mode", "coordinator_trust_material", "coordinator_material", "all_paths_local_to_attested_host", "certificate_chain_eku_san_expiry_verified", "private_key_redistribution_after_initial_placement_allowed"],
      "properties": {
        "mode": {"const": "OWNER_MEDIATED_OUT_OF_BAND_EXACT_HASH_PLACEMENT"},
        "ca_certificate_path": {"$ref": "#/$defs/absolute_path"},
        "ca_certificate_sha256": {"$ref": "#/$defs/sha256"},
        "domain_identity": {"$ref": "#/$defs/placed_identity"},
        "domain_operator_public_key_path": {"$ref": "#/$defs/absolute_path"},
        "domain_operator_private_key_path": {"$ref": "#/$defs/absolute_path"},
        "domain_operator_public_key_sha256": {"$ref": "#/$defs/sha256"},
        "domain_operator_private_key_file_mode": {"const": "0600"},
        "coordinator_trust_material": {"$ref": "#/$defs/coordinator_trust_material"},
        "coordinator_material": {"oneOf": [{"$ref": "#/$defs/coordinator_material"}, {"type": "null"}]},
        "all_paths_local_to_attested_host": {"const": true},
        "certificate_chain_eku_san_expiry_verified": {"const": true},
        "private_key_redistribution_after_initial_placement_allowed": {"const": false}
      }
    },
    "process_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed_protocol_command_enum_only", "arbitrary_command_or_shell_allowed", "shell_evaluation_allowed", "ambient_credentials_allowed", "proxy_environment_inherited", "host_global_network_mutation_allowed", "host_reboot_or_power_action_allowed", "owned_process_and_run_root_scope_required"],
      "properties": {
        "fixed_protocol_command_enum_only": {"const": true},
        "arbitrary_command_or_shell_allowed": {"const": false},
        "shell_evaluation_allowed": {"const": false},
        "ambient_credentials_allowed": {"const": false},
        "proxy_environment_inherited": {"const": false},
        "host_global_network_mutation_allowed": {"const": false},
        "host_reboot_or_power_action_allowed": {"const": false},
        "owned_process_and_run_root_scope_required": {"const": true}
      }
    },
    "signature_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer_role", "signer_public_key_sha256", "signature_scheme", "signature_namespace", "detached_signature_required", "signature_embedded"],
      "properties": {
        "signer_role": {"const": "T22_A1_DOMAIN_OPERATOR"},
        "signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
        "signature_scheme": {"const": "OPENSSH_SSHSIG_ED25519"},
        "signature_namespace": {"const": "agent-bridge-t22-a1-domain-readiness-v1"},
        "detached_signature_required": {"const": true},
        "signature_embedded": {"const": false}
      }
    },
    "collection_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_accessed", "external_hosts_contacted", "listeners_started", "services_started", "faults_injected", "spend_usd_cents"],
      "properties": {
        "network_accessed": {"const": false},
        "external_hosts_contacted": {"const": 0},
        "listeners_started": {"const": 0},
        "services_started": {"const": 0},
        "faults_injected": {"const": 0},
        "spend_usd_cents": {"const": 0}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness_is_execution_authority", "credential_placement_proved_for_this_host", "three_domain_execution_proved", "production_admissible"],
      "properties": {
        "readiness_is_execution_authority": {"const": false},
        "credential_placement_proved_for_this_host": {"const": true},
        "three_domain_execution_proved": {"const": false},
        "production_admissible": {"const": false}
      }
    }
  }
}
