{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_bridge.memory_temporal_owned_lab_owner_trust_anchor_s18.v0",
  "title": "Agent-Bridge S18 out-of-band owned-lab owner trust anchor",
  "description": "Closed trust-anchor document installed independently of any authorization envelope. This document contains only a public Ed25519 key and non-secret owner metadata; it is not an authorization decision or execution capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_kind",
    "canonicalization",
    "anchor_state",
    "installation_source",
    "owner_role",
    "owner_identity_sha256",
    "owner_key_id",
    "owner_key_version",
    "signature_algorithm",
    "ed25519_public_key_hex",
    "trust_policy_sha256",
    "minimum_revocation_epoch",
    "audience",
    "authorized_claim_level",
    "authorized_family_namespace",
    "installation_receipt_sha256",
    "owner_identity_verification_receipt_sha256",
    "private_key_present",
    "self_asserted_key_is_owner_authentication",
    "authorization_envelope_embedded",
    "execution_capability_embedded",
    "provider_or_production_authority",
    "side_effects_unlocked"
  ],
  "properties": {
    "schema": {"const": "agent_bridge.memory_temporal_owned_lab_owner_trust_anchor_s18.v0"},
    "packet_kind": {"const": "OUT_OF_BAND_OWNED_LAB_OWNER_TRUST_ANCHOR"},
    "canonicalization": {"const": "AB_RESTRICTED_CANONICAL_JSON_S18_V1_COMPACT_SORTED_KEYS_ASCII_VALUES_NO_FLOAT"},
    "anchor_state": {"const": "ACTIVE_OWNER_PINNED_PUBLIC_KEY"},
    "installation_source": {"const": "OWNER_CONTROLLED_OUT_OF_BAND_PIN_NOT_AUTHORIZATION_ENVELOPE"},
    "owner_role": {"const": "OWNED_LAB_EXECUTION_OWNER"},
    "owner_identity_sha256": {"$ref": "#/$defs/sha256"},
    "owner_key_id": {"$ref": "#/$defs/label"},
    "owner_key_version": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "signature_algorithm": {"const": "Ed25519"},
    "ed25519_public_key_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trust_policy_sha256": {"$ref": "#/$defs/sha256"},
    "minimum_revocation_epoch": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "audience": {"const": "AGENT_BRIDGE_S18_OWNED_LAB_L1_ONLY"},
    "authorized_claim_level": {"const": "L1_PROCESS_CRASH_FRESH_PROCESS_RESTART_ONLY"},
    "authorized_family_namespace": {"const": "OL00_OL04_OL05_FIRST_BATCH"},
    "installation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "owner_identity_verification_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "private_key_present": {"const": false},
    "self_asserted_key_is_owner_authentication": {"const": false},
    "authorization_envelope_embedded": {"const": false},
    "execution_capability_embedded": {"const": false},
    "provider_or_production_authority": {"const": false},
    "side_effects_unlocked": {"const": "NONE"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    }
  }
}
