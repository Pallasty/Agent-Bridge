        "stop_policy_sha256": {"$ref": "#/$defs/sha256"},
        "revocation_policy_sha256": {"$ref": "#/$defs/sha256"},
        "retention_policy_sha256": {"$ref": "#/$defs/sha256"},
        "cleanup_policy_sha256": {"$ref": "#/$defs/sha256"},
        "custody_policy_sha256": {"$ref": "#/$defs/sha256"},
