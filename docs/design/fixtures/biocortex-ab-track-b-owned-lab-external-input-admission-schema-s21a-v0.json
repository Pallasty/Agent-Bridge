      "properties": {
        "authorization_id_sha256": {"$ref": "#/$defs/sha256"},
        "final_refreeze_subject_sha256": {"$ref": "#/$defs/sha256"},
        "owner_envelope_sha256": {"$ref": "#/$defs/sha256"},
        "provider_identity_sha256": {"$ref": "#/$defs/sha256"},
        "provider_trust_anchor_sha256": {"$ref": "#/$defs/sha256"},
