      "required": ["authorization_id_sha256", "final_refreeze_subject_sha256", "owner_envelope_sha256", "capability_nonce_sha256", "registrar_identity_sha256", "external_control_plane_identity_sha256", "provenance_receipt_sha256", "creator_binary_sha256", "expected_unclaimed_revision", "previous_revision", "registration_revision", "successful_claim_count", "claimed_run_id_sha256", "registration_receipt_sha256", "registration_state", "binding_validated", "registered_by_external_control_plane", "created_by_runner"],
