      "required": ["lab_environment_sha256", "stop_policy_sha256", "revocation_policy_sha256", "retention_policy_sha256", "cleanup_policy_sha256", "custody_policy_sha256", "review_policy_sha256", "independent_review_receipt_sha256", "current_revocation_epoch", "automatic_or_implicit_retry_allowed"],
      "properties": {
