        "committed_content_root_sha256": {"$ref": "#/$defs/sha256"},
        "monotonic_counter": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "previous_checkpoint_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "observed_revocation_epoch": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "checkpoint_state": {"enum": ["MISSING", "PREPARED", "COMMITTED_CURRENT", "STALE", "FORKED", "ROLLBACK_DETECTED", "ACKNOWLEDGEMENT_UNKNOWN"]},
        "provider_present": {"type": "boolean"},
        "independent_failure_domain_proved": {"type": "boolean"},
        "same_failure_domain_as_database": {"type": "boolean"},
        "acknowledgement_semantics_validated": {"type": "boolean"}
