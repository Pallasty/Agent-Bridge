        "creator_binary_sha256": {"$ref": "#/$defs/sha256"},
        "expected_unclaimed_revision": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "previous_revision": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "registration_revision": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "successful_claim_count": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "claimed_run_id_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "registration_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "registration_state": {"enum": ["MISSING", "AUTHORIZED_UNCLAIMED_PRESENT", "CONSUMED", "UNKNOWN"]},
        "binding_validated": {"type": "boolean"},
        "registered_by_external_control_plane": {"type": "boolean"},
