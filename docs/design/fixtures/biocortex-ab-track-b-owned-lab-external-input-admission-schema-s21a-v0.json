{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_bridge.memory_temporal_owned_lab_external_input_admission_s21a.v0",
  "title": "Agent-Bridge S21A external-input admission result",
  "description": "Closed non-executing validation result for independently supplied S21B inputs. Even the complete state requires separate review and grants no permit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packet_kind", "canonicalization", "hashing_contract", "admission_state", "test_only", "synthetic", "subject_binding", "owner_binding", "checkpoint_input", "external_registration", "runtime_inputs", "policy_bindings", "result", "admission_packet_sha256", "nonclaims"],
  "properties": {
    "schema": {"const": "agent_bridge.memory_temporal_owned_lab_external_input_admission_s21a.v0"},
    "packet_kind": {"const": "S21A_EXTERNAL_INPUT_ADMISSION_RESULT"},
    "canonicalization": {"const": "AB_RESTRICTED_CANONICAL_JSON_S21A_V1_COMPACT_SORTED_KEYS_ASCII_VALUES_NO_FLOAT"},
    "hashing_contract": {"$ref": "#/$defs/hashing_contract"},
    "admission_state": {"enum": ["SYNTHETIC_KAT_BLOCKED_NON_LIVE", "BLOCKED_FAIL_CLOSED", "INPUTS_COMPLETE_PENDING_SEPARATE_REVIEW_NON_EXECUTING"]},
    "test_only": {"type": "boolean"},
    "synthetic": {"type": "boolean"},
    "subject_binding": {"$ref": "#/$defs/subject_binding"},
    "owner_binding": {"$ref": "#/$defs/owner_binding"},
    "checkpoint_input": {"$ref": "#/$defs/checkpoint_input"},
    "external_registration": {"$ref": "#/$defs/external_registration"},
    "runtime_inputs": {"$ref": "#/$defs/runtime_inputs"},
    "policy_bindings": {"$ref": "#/$defs/policy_bindings"},
    "result": {"$ref": "#/$defs/result"},
    "admission_packet_sha256": {"$ref": "#/$defs/sha256"},
    "nonclaims": {"$ref": "#/$defs/nonclaims"}
  },
  "allOf": [
    {
      "if": {"properties": {"test_only": {"const": true}}, "required": ["test_only"]},
      "then": {
        "properties": {
          "synthetic": {"const": true},
          "admission_state": {"const": "SYNTHETIC_KAT_BLOCKED_NON_LIVE"},
          "result": {
            "properties": {
              "all_external_inputs_validated": {"const": false},
              "terminal_hard_lock": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"admission_state": {"const": "INPUTS_COMPLETE_PENDING_SEPARATE_REVIEW_NON_EXECUTING"}}, "required": ["admission_state"]},
      "then": {
        "properties": {
          "test_only": {"const": false},
          "synthetic": {"const": false},
          "subject_binding": {
            "properties": {
              "final_post_integration_subject_validated": {"const": true},
              "exact_s21a_commit_tree_and_build_bound": {"const": true}
            }
          },
          "owner_binding": {
            "properties": {
              "new_owner_signature_valid": {"const": true},
              "trust_anchor_installed_and_pinned": {"const": true}
            }
          },
          "checkpoint_input": {
            "properties": {
              "checkpoint_state": {"const": "COMMITTED_CURRENT"},
              "provider_present": {"const": true},
              "independent_failure_domain_proved": {"const": true},
              "same_failure_domain_as_database": {"const": false},
              "acknowledgement_semantics_validated": {"const": true},
              "observed_revocation_epoch": {"type": "integer", "minimum": 1}
            }
          },
          "external_registration": {
            "properties": {
              "registration_state": {"const": "AUTHORIZED_UNCLAIMED_PRESENT"},
              "binding_validated": {"const": true},
              "created_by_runner": {"const": false},
              "registered_by_external_control_plane": {"const": true},
              "successful_claim_count": {"const": 0},
              "claimed_run_id_sha256": {"type": "null"}
            }
          },
          "runtime_inputs": {
            "properties": {
              "fresh_observer_present_and_bound": {"const": true},
              "real_runner_present_and_bound": {"const": true},
              "exact_environment_present_and_bound": {"const": true},
              "exact_canary_inputs_present_and_bound": {"const": true},
              "stop_and_revocation_fresh_and_exact": {"const": true}
            }
          },
          "result": {
            "properties": {
              "all_external_inputs_validated": {"const": true},
              "terminal_hard_lock": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "checkpoint_input": {
            "properties": {"monotonic_counter": {"const": 1}},
            "required": ["monotonic_counter"]
          }
        },
        "required": ["checkpoint_input"]
      },
      "then": {
        "properties": {
          "checkpoint_input": {
            "properties": {"previous_checkpoint_sha256": {"type": "null"}}
          }
        }
      },
      "else": {
        "properties": {
          "checkpoint_input": {
            "properties": {"previous_checkpoint_sha256": {"$ref": "#/$defs/sha256"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "hashing_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "canonicalization", "digest_domain", "digest_framing", "hash_scope", "self_hash_field", "self_hash_field_excluded", "repository_framing_lf_excluded", "cross_field_semantic_validation_required", "candidate_reported_matches_authoritative"],
      "properties": {
        "hash_algorithm": {"const": "SHA-256"},
        "canonicalization": {"const": "AB_RESTRICTED_CANONICAL_JSON_S21A_V1_COMPACT_SORTED_KEYS_ASCII_VALUES_NO_FLOAT"},
        "digest_domain": {"const": "agent-bridge/biocortex/owned-lab/s21a/external-input-admission/v1"},
        "digest_framing": {"const": "U32BE_DOMAIN_LENGTH_DOMAIN_U64BE_CANONICAL_PAYLOAD_LENGTH_CANONICAL_PAYLOAD"},
        "hash_scope": {"const": "ENTIRE_PACKET_EXCEPT_ADMISSION_PACKET_SHA256"},
        "self_hash_field": {"const": "admission_packet_sha256"},
        "self_hash_field_excluded": {"const": true},
        "repository_framing_lf_excluded": {"const": true},
        "cross_field_semantic_validation_required": {"const": true},
        "candidate_reported_matches_authoritative": {"const": false}
