{
  "$defs": {
    "blocker": {
      "maxLength": 192,
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]{0,191}$",
      "type": "string"
    },
    "label": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "sha256": {
      "description": "Lowercase SHA-256 digest; the validator additionally rejects the all-zero digest.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "utc": {
      "maxLength": 20,
      "minLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$id": "urn:agent-bridge:biocortex-ab:track-b:local-guard-validation-receipt:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Replayable local validation receipt for the pre-output tuple. This receipt is not an output permit, performs no authorizing consumption, emits no live capability, and unlocks no side effect.",
  "properties": {
    "admission_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "all_generator_paths_guarded": {
      "const": false
    },
    "answer_blinding_seed_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authority_scope": {
      "const": "LOCAL_VALIDATION_ONLY_NOT_OUTPUT_AUTHORITY"
    },
    "authorizing_consumption_performed": {
      "const": false
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/blocker"
      },
      "maxItems": 64,
      "minItems": 5,
      "type": "array",
      "uniqueItems": true
    },
    "caller_prior_output_absence_verified": {
      "const": false
    },
    "condition_output_authorized": {
      "const": false
    },
    "condition_roster_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "contract_core_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "decision": {
      "const": "SOURCE_PROFILE_PASS_BLOCKED_FAIL_CLOSED_EXTERNAL_ATOMIC_AUTHORITY_AND_NON_BYPASSABLE_OUTPUT_PATH_UNBOUND"
    },
    "eligible_frame_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evaluated_at_utc": {
      "$ref": "#/$defs/utc"
    },
    "external_anti_rollback_anchor_present": {
      "const": false
    },
    "external_authority_linearizability_verified": {
      "const": false
    },
    "external_authority_provider_present": {
      "const": false
    },
    "external_global_single_use_verified": {
      "const": false
    },
    "external_owner_trust_verified": {
      "const": false
    },
    "first_output_slot_bound": {
      "const": true
    },
    "first_output_unit_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generation_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generation_session_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "live_output_capability_emitted": {
      "const": false
    },
    "local_custodian_terminal_success_verified": {
      "const": true
    },
    "local_generation_plan_verified": {
      "const": true
    },
    "local_guard_source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "local_guard_validation_receipt_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "local_time_order_consistent": {
      "const": true
    },
    "local_validation_receipt_replayable": {
      "const": true,
      "description": "The same valid local tuple may produce the same receipt again; no authority is consumed."
    },
    "non_bypassable_output_path_verified": {
      "const": false
    },
    "owner_trial_registration_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "post_generation_map_intentionally_absent": {
      "const": true
    },
    "pre_output_generation_plan_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "protocol_version": {
      "const": 1
    },
    "receipt_is_output_permit": {
      "const": false,
      "description": "This local receipt is never a bearer capability or authorization to emit condition output."
    },
    "sampling_attempt_namespace_claim_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sampling_attempt_namespace_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sampling_event_sha256": {
