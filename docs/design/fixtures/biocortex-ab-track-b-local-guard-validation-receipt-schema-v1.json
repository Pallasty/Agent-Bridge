    },
    "sampling_write_outcome_custodian_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sampling_write_request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "schema": {
      "const": "agent_bridge.biocortex_ab_track_b_local_guard_validation_receipt.v1"
    },
    "selected_case_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "selection_commitment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "side_effects_unlocked": {
      "const": "NONE"
    },
    "source_identity_verified": {
      "const": true
    },
    "status": {
      "const": "LOCAL_PRE_OUTPUT_TUPLE_VALIDATION_ONLY_NO_LIVE_OUTPUT_PERMIT"
    },
    "strata_allocation_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "trial_id": {
      "$ref": "#/$defs/label"
    },
    "trusted_pre_output_order_verified": {
      "const": false
    }
  },
  "required": [
