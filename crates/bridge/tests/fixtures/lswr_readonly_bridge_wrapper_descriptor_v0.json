    "required_display_status_label": "Ready for read-only display",
    "required_display_status_tone": "success",
    "required_wrapper_ready": true,
    "required_matrix_gates": [
      "schema_chain",
      "packet_summary_consistency",
      "read_only_safety",
      "query_surface_contract",
      "report_markdown_consistency",
      "feedback_verdict_separation"
    ],
    "review_sensitive_gates": [
      "detailed_readback"
