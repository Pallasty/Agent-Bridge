    "display_model_schema": "agent_bridge.lswr.readonly_bridge_display_model.v0"
  },
  "profile_gate": {
    "current_exposure": "not_registered",
    "candidate_tool_name": "lswr_readonly_bridge_display",
    "mcp_registry_change": false,
    "codex_essential_status": "not_exposed",
