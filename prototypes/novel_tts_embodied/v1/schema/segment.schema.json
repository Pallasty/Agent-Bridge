{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/ab/novel_tts_embodied/segment.schema.json",
  "title": "NovelTtsSegment",
  "type": "object",
  "required": [
    "segment_id",
    "chapter",
    "index",
    "text",
    "speaker",
    "emotion",
    "voice_profile",
    "status",
    "audio_plan"
  ],
  "properties": {
    "segment_id": { "type": "string" },
    "chapter": { "type": "integer", "minimum": 1 },
    "index": { "type": "integer", "minimum": 0 },
    "text": { "type": "string", "minLength": 1 },
    "speaker": {
      "type": "object",
      "required": ["id", "name", "gender", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "gender": {
          "type": "string",
          "enum": ["unknown", "male", "female", "narrator"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "emotion": {
      "type": "object",
      "required": ["label", "intensity", "confidence"],
      "properties": {
        "label": {
          "type": "string",
          "enum": ["neutral", "calm", "happy", "sad", "angry", "tense"]
        },
        "intensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "voice_profile": {
      "type": "object",
      "required": ["voice_key", "backend", "speed", "pause_ms", "gain_db", "pitch_shift"],
      "properties": {
        "voice_key": { "type": "string" },
        "backend": { "type": "string" },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
        "pause_ms": { "type": "number", "minimum": 0, "maximum": 3000 },
        "gain_db": { "type": "number", "minimum": -6, "maximum": 6 },
        "pitch_shift": { "type": "number", "minimum": -6, "maximum": 6 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["ready", "needs_review", "failed"]
    },
    "audio_plan": {
      "type": "object",
      "required": ["segment_hash", "output_file", "estimated_duration_sec", "cached"],
      "properties": {
        "segment_hash": { "type": "string" },
        "output_file": { "type": "string" },
        "estimated_duration_sec": { "type": "number", "minimum": 0 },
        "cached": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "fallbacks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speaker_source": { "type": "string" },
        "emotion_source": { "type": "string" },
        "raw_speaker_hint": { "type": "string" },
        "raw_emotion_hint": { "type": "string" },
        "annotation_issues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "error": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
