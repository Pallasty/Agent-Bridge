{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/ab/novel_tts_embodied/annotations.schema.json",
  "title": "NovelTtsAnnotationInput",
  "description": "Sub-agent/LLM supplied segment-level speaker/emotion hints for novel_tts_embodied.",
  "oneOf": [
    {
      "type": "array",
      "items": { "$ref": "#/definitions/annotation_row_with_index" }
    },
    {
      "type": "object",
      "description": "Index-keyed map form, where key is a segment index.",
      "patternProperties": {
        "^\\d+$": { "$ref": "#/definitions/annotation_row" }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "speaker_hint": {
      "type": "object",
      "required": ["id", "name", "gender"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "gender": { "type": "string", "enum": ["male", "female", "narrator", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string", "minLength": 1 },
        "raw_hint": { "type": "string" }
      },
      "additionalProperties": true
    },
    "emotion_hint": {
      "type": "object",
      "required": ["label", "intensity"],
      "properties": {
        "label": {
          "type": "string",
          "enum": ["neutral", "calm", "happy", "sad", "angry", "tense"]
        },
        "intensity": { "type": "integer", "minimum": 0, "maximum": 2 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string", "minLength": 1 },
        "raw_hint": { "type": "string" }
      },
      "additionalProperties": true
    },
    "annotation_row": {
      "type": "object",
      "properties": {
        "speaker": { "$ref": "#/definitions/speaker_hint" },
        "emotion": { "$ref": "#/definitions/emotion_hint" }
      },
      "anyOf": [
        { "required": ["speaker"] },
        { "required": ["emotion"] }
      ],
      "additionalProperties": true
    },
    "annotation_row_with_index": {
      "allOf": [
        { "$ref": "#/definitions/annotation_row" },
        {
          "type": "object",
          "required": ["index"],
          "properties": {
            "index": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  }
}
