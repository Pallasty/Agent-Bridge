{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/ab/novel_tts_embodied/manifest.schema.json",
  "title": "NovelTtsManifest",
  "type": "object",
  "required": [
    "version",
    "created_at",
    "input",
    "segments_path",
    "fallback_stats",
    "segments",
    "summary"
  ],
  "properties": {
    "version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "input": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "additionalProperties": true
    },
    "segments_path": { "type": "string" },
    "fallback_stats": {
      "type": "object",
      "required": ["fallback_segments", "needs_review", "failed_segments"],
      "properties": {
        "fallback_segments": { "type": "integer", "minimum": 0 },
        "needs_review": { "type": "integer", "minimum": 0 },
        "failed_segments": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["segment_count", "total_chars", "estimated_total_sec", "duration_sec"],
      "properties": {
        "segment_count": { "type": "integer", "minimum": 0 },
        "total_chars": { "type": "integer", "minimum": 0 },
        "estimated_total_sec": { "type": "number", "minimum": 0 },
        "duration_sec": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "segments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "string"
    },
    "annotation_issues": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "object",
          "required": ["count", "global_count", "row_count", "summary_text"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "global_count": { "type": "integer", "minimum": 0 },
            "row_count": { "type": "integer", "minimum": 0 },
            "summary_text": { "type": "string" }
          },
          "additionalProperties": false
        },
        "rows": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "all": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
