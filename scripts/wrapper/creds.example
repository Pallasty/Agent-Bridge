# Example credentials file for agent-bridge wrapper env injection.
#
# COPY this file to one of:
#   ~/Documents/ClaudeCode.txt           (default on macOS)
#   /Media/Ubuntu/Documents/ClaudeCode.txt (default on Linux when present)
# Or any path of your choice + set AGENT_BRIDGE_CREDS_FILE to point at it.
#
# Replace REPLACE_ME placeholders with real tokens. Sections you don't need
# can be left empty or deleted — the wrapper silently skips missing sections.
# Order does NOT matter except within each section.
#
# Sections are matched by `# <NAME>` markers; a blank line ends a section.
# (Cloudflare Workers uses `## <NAME>` because it's a sub-section under a
# parent `# Cloudflare endpoint` block — see comment near it.)


# Agent-Bridge Primary
# Used by the wrapper for memory-layer LLM calls (P4b filter, P5 dream replay).
# Wrapper reads ONLY this section — no "first sk-* anywhere" fallback (that
# behaviour silently resurfaced dead historical keys like anyrouter and broke
# the active proxy).  If this section is empty/missing, the wrapper leaves
# ANTHROPIC_* unset and LlmClient skips straight to the OpenAI Fallback.
# To switch active proxy, edit these two lines (no script changes needed).
#
# Confirmed-alive Anthropic-protocol proxies (2026-05-10 audit; rotate when dead):
#   https://api.bltcy.ai           — claude-haiku-4-5-20251001 / sonnet-4-5
#   https://api.bltcy.cn           — sister of bltcy.ai
#   https://ai.comfly.chat         — same model surface
#   https://code.wenwen-ai.com     — same model surface
#   https://api.anthropic.com      — direct (use if you have sk-ant-*)
export ANTHROPIC_AUTH_TOKEN=REPLACE_ME_sk_your_anthropic_proxy_token
export ANTHROPIC_BASE_URL=https://api.bltcy.ai


# Agent-Bridge Fallback
# OpenAI-protocol secondary used when Primary fails (network blip, quota,
# outage). LlmClient (commit 16c463b) auto-retries here once. Optional —
# omit if you want strict single-provider semantics. Fallback model is
# read separately because model names aren't portable across protocols.
# Example uses modelscope (free Qwen3-235B); swap for Groq / OpenRouter /
# Gemini openai-compat / OpenAI direct as needed.
export OPENAI_API_KEY=REPLACE_ME_openai_or_modelscope_or_groq_token
export OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
export AGENT_BRIDGE_LLM_FALLBACK_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507


# Tailscale API
Client ID: REPLACE_ME_tskey_oauth_client_id
Client secret: REPLACE_ME_tskey_oauth_client_secret


# Github PAT Token
github_pat_REPLACE_ME_with_your_github_personal_access_token


# GitLab PAT token
glpat-REPLACE_ME_with_your_gitlab_personal_access_token


# Notion API
ntn_REPLACE_ME_with_your_notion_integration_token


# Brave Search API
BSAREPLACE_ME_with_your_brave_search_subscription_token


# Cloudflare endpoint
ID：REPLACE_ME_cloudflare_account_id Key: REPLACE_ME_cloudflare_global_api_key

## Cloudflare Workers API
REPLACE_ME_cloudflare_workers_api_token_at_least_16_chars_long
