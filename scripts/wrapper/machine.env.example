# agent-bridge per-machine env overrides — EXAMPLE
#
# Copy to ~/.config/agent-bridge/machine.env (or set AGENT_BRIDGE_MACHINE_ENV
# to another path) and uncomment the lines that apply to THIS host. The wrapper
# (scripts/wrapper/agent-bridge-wrapper.sh) sources this file before its
# always-on defaults, so values here act like per-host caller env.
#
# Convention: use `export VAR="${VAR:-value}"` guards so a true per-call
# override (`VAR=… agent-bridge …`) still wins over the per-host default.
#
# This file is per-host and must NOT be committed to the shared repo — hosts
# differ (different SKUs, paths, checkouts).

# --- Durable private state ---
# Use a local filesystem that enforces POSIX owner-only modes. This common root
# holds privacy-bounded journals such as Avatar expression outcomes. On older
# installations the wrapper can also derive this root from an absolute
# AB_APP_CONTROL_OPERATION_DIR ending in `/app_control_operations`.
#
# export AGENT_BRIDGE_STATE_DIR="${AGENT_BRIDGE_STATE_DIR:-/path/to/private/agent-bridge-state}"

# --- Context window (forum #1758) ---
# Set ONLY on a host whose sessions run the 1M-context beta. The opus-4.x /
# sonnet-4.x model id is identical for the 200K and 1M SKUs, so the tool can't
# detect it — this is how a 1M host tells context_pressure_estimate the truth.
# A 200K host must leave this UNSET (setting it would under-report fatigue and
# risk overrunning the real window).
#
# export AGENT_BRIDGE_CONTEXT_WINDOW="${AGENT_BRIDGE_CONTEXT_WINDOW:-1000000}"

# --- Retrieval telemetry provenance (schema v42) ---
# Normal interactive/daemon processes should identify their telemetry as
# organic. Benchmarks and verifier scripts override this to `eval` at their
# process boundary. Unset, empty, and invalid values persist as `unknown`; the
# bridge never guesses provenance from query text, mode, keys, or timestamps.
#
# export AGENT_BRIDGE_RETRIEVAL_TRAFFIC_CLASS="${AGENT_BRIDGE_RETRIEVAL_TRAFFIC_CLASS:-organic}"

# --- Voice embodiment (explicit opt-in) ---
# `codex-voice` keeps the compact codex-essential surface and adds only the
# bounded voice lane. It does not itself synthesize, play, or record anything;
# those remain explicit tool calls. Leave the ordinary Codex profile unchanged
# on hosts where voice must remain unavailable.
#
# export AGENT_BRIDGE_TOOLSET="${AGENT_BRIDGE_TOOLSET:-codex-voice}"
#
# Configure only assets actually installed on this host. The read-only
# voice_runtime_preflight reports missing entries and never downloads models.
#
# export AB_TTS_SYNTH_BIN="${AB_TTS_SYNTH_BIN:-$HOME/.local/bin/ab-tts-synth}"
# export AB_TTS_KOKORO_MODEL="${AB_TTS_KOKORO_MODEL:-$HOME/.local/share/ab-tts/kokoro-v1.0.onnx}"
# export AB_TTS_KOKORO_VOICES="${AB_TTS_KOKORO_VOICES:-$HOME/.local/share/ab-tts/voices-v1.0.bin}"
# export AB_TTS_PIPER_MODEL="${AB_TTS_PIPER_MODEL:-$HOME/.local/share/ab-tts/piper/voices/en_US-lessac-medium.onnx}"
# export AB_TTS_PIPER_PHONEMIZE="${AB_TTS_PIPER_PHONEMIZE:-$HOME/.local/share/ab-tts/piper/piper_phonemize}"
# export AB_TTS_STT_BIN="${AB_TTS_STT_BIN:-$HOME/.local/share/ab-tts/whisper/whisper-cli}"
# export AB_TTS_STT_MODEL="${AB_TTS_STT_MODEL:-$HOME/.local/share/ab-tts/ggml-tiny.en.bin}"
#
# Qwen3 Rust remains a separate explicit enablement decision. Do not add
# AB_QWEN3_TTS_RUST_ENABLED=1 merely to make preflight green.

# --- gte-768 embedding RAM reduction (~2.28GB across daemon + daemon-http) ---
# RECOMMENDED: run `scripts/deploy-gte-int8-embedding.sh` once per host (after the
# binary is updated). It generates the embedding-only int8 gte model and installs
# systemd --user drop-ins for both knobs below — no machine.env edits needed.
#
# The two knobs (set here only if you prefer machine.env over systemd drop-ins):
#  - AGENT_BRIDGE_ONNX_MODEL_DIR: point at the int8 model dir so BOTH daemon-http
#    (the /embed server) and the daemon fallback path load the smaller model.
#  - AGENT_BRIDGE_EMBED_REMOTE_URL: the shared daemon-http /embed. MCP/CLI processes
#    delegate to it (avoid an ~2.8GB local copy each). NOTE: as of the
#    daemon-embed-delegation change the `daemon` arm ALSO honors this and delegates
#    to daemon-http (dropping its own ~1.2GB copy); daemon-http itself never
#    delegates (its arm does not install delegation), so it cannot self-loop.
#
# export AGENT_BRIDGE_ONNX_MODEL_DIR="${AGENT_BRIDGE_ONNX_MODEL_DIR:-$HOME/.cache/agent-bridge/onnx-models-int8}"
# export AGENT_BRIDGE_EMBED_REMOTE_URL="${AGENT_BRIDGE_EMBED_REMOTE_URL:-http://127.0.0.1:7878/embed}"
