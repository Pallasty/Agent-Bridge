# systemd user unit — agent-bridge daemon-http (local by default, port 7878).
#
# Local-only HTTP endpoint for forum + memory sync,
# embed text dispatcher (`/embed`), and agent messaging primitives.
# Remote exposure must explicitly bind a specific tailnet address and apply an
# ACL; do not expose the unauthenticated write routes on every interface.
#
# See agent-bridge-daemon.service for context on why these units exist.

[Unit]
Description=Agent-Bridge daemon-http (local HTTP API, port 7878)
Documentation=file://%h/.claude/projects/-Data-CascadeProjects-agent-bridge/memory/lesson_kernel_vmap_softhang_2026_05_19.md
After=network.target agent-bridge-daemon.service

[Service]
Type=simple
WorkingDirectory=/Data/CascadeProjects/agent-bridge
ExecStart=%h/.local/bin/agent-bridge daemon-http --listen 127.0.0.1:7878
Restart=on-failure
# Exit 78 (EX_CONFIG) = embedding dim-guard class-1 abort (stale config/store dim
# mismatch); won't self-heal across restarts, so don't crash-loop — surface a
# clean `failed` state. Fix the env/model or set AGENT_BRIDGE_DIM_GUARD_STRICT=0.
RestartPreventExitStatus=78
RestartSec=5
OOMScoreAdjust=-100
# Soft cgroup ceiling. MUST stay above the gte ONNX model footprint: a gte-768
# embedder process loads its own ~1.8G ORT session (steady RSS ~1.8-2.5G). The
# old 1G value predated the gte-768 cutover (2026-06-25) and sat BELOW the
# pre-model baseline, so every model allocation past memory.high hit synchronous
# direct reclaim and a ~22s cold-load throttled into ~8.5h — during which /embed
# silently served a hash vector mislabeled "gte" (forum #137, fixed 2026-06-27).
# 4G leaves headroom over steady RSS + load transient; MemoryMax is deliberately
# unset (systemd default: no hard cgroup cap / no OOM), and OOMScoreAdjust
# protects under host pressure. Re-tune this if the embedding model footprint
# changes again.
MemoryHigh=4G
StandardOutput=append:%h/.cache/agent-bridge/daemon-http.log
StandardError=append:%h/.cache/agent-bridge/daemon-http.log
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=default.target
