# Nightly trigger for agent-bridge-digest.service — 05:00, after the 03:42
# hygiene cycle and the 04:30 distill batch, so topic selection sees the
# cleaned, post-distill store. Persistent=true fires a missed run at the
# next boot (laptop-friendly, same posture as the other nightly units).

[Unit]
Description=agent-bridge nightly digest-author draft batch trigger

[Timer]
OnCalendar=*-*-* 05:00:00
Persistent=true

[Install]
WantedBy=timers.target
